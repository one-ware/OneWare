<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <ItemGroup>
        <!--
            Pinned to 11.3.12.1: 11.3.12.2+ introduced deferred cell recycling which unrealizes
            cells from TreeDataGridCellsPresenter.OnDetachedFromVisualTree. Rebuilding a cell's
            ContentPresenter child while the subtree is mid-detach throws
            "Visual is atached to visual tree but root could not be found".
        -->
        <PackageReference Include="TreeDataGrid" Version="11.3.12.1"/>
    </ItemGroup>
</Project>
