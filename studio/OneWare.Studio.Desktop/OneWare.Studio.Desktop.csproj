<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\build\props\Base.props"/>
    <Import Project="..\..\build\props\Avalonia.Desktop.props"/>
    <!-- Bundles the Copilot runtime (runtimes/<rid>/native) matching the SDK used by OneWare.Copilot. -->
    <Import Project="..\..\build\props\GitHub.Copilot.SDK.props"/>

    <PropertyGroup>
        <Version>$(StudioVersion)</Version>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <OutputType Condition="'$(Configuration.toUpper())' != 'DEBUG'">WinExe</OutputType>
        <OutputType Condition="'$(Configuration.toUpper())' == 'DEBUG'">Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ApplicationIcon>..\OneWare.Studio\Assets\icon.ico</ApplicationIcon>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <AssemblyName>OneWareStudio</AssemblyName>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <PropertyGroup>
        <InvariantGlobalization>true</InvariantGlobalization>
        <SelfContained>true</SelfContained>
        <PublishReadyToRun>true</PublishReadyToRun>
        <!-- TODO we can experiment with this to improve startup performance and size, but it causes issues with reflection and we need to make sure to test all features if we enable it.
        <PublishSingleFile>true</PublishSingleFile>
        <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
        <PublishTrimmed>false</PublishTrimmed>
        -->
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\OneWare.Chat\OneWare.Chat.csproj"/>
        <ProjectReference Include="..\..\src\OneWare.CloudIntegration\OneWare.CloudIntegration.csproj"/>
        <ProjectReference Include="..\..\src\OneWare.Copilot\OneWare.Copilot.csproj"/>
        <!--<ProjectReference Include="..\..\src\OneWare.CSharp\OneWare.CSharp.csproj"/>-->
        <ProjectReference Include="..\..\src\OneWare.PackageManager\OneWare.PackageManager.csproj"/>
        <ProjectReference Include="..\..\src\OneWare.Python\OneWare.Python.csproj"/>
        <ProjectReference Include="..\..\src\OneWare.SourceControl\OneWare.SourceControl.csproj"/>
        <ProjectReference Include="..\..\src\OneWare.TerminalManager\OneWare.TerminalManager.csproj"/>
        <ProjectReference Include="..\..\src\OneWare.Updater\OneWare.Updater.csproj"/>
        <ProjectReference Include="..\..\src\OneWare.SerialMonitor\OneWare.SerialMonitor.csproj"/>
        <ProjectReference Include="..\..\src\OneWare.OssCadSuiteIntegration\OneWare.OssCadSuiteIntegration.csproj"/>
        <ProjectReference Include="..\..\src\OneWare.ToolEngine\OneWare.ToolEngine.csproj"/>
        <ProjectReference Include="..\..\src\OneWare.Verilog\OneWare.Verilog.csproj"/>
        <ProjectReference Include="..\..\src\OneWare.Vhdl\OneWare.Vhdl.csproj"/>
        <ProjectReference Include="..\OneWare.Studio\OneWare.Studio.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\Startup.png"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Required by the redistribution terms of the bundled Copilot runtime. -->
        <None Include="ThirdPartyLicenses\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    </ItemGroup>

    <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64' OR '$(RuntimeIdentifier)' == 'linux-arm64'">
        <Content Include="com.one_ware.OneWare.desktop" CopyToOutputDirectory="PreserveNewest"/>
        <Content Include="com.one_ware.OneWare.metainfo.xml" CopyToOutputDirectory="PreserveNewest"/>
        <Content Include="com.one_ware.OneWare.mime.xml" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <!--Exclude Terminal on Linux to stop crashes on SetWindowSize. TODO: Check if this is still needed-->
    <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
        <PublishReadyToRunExclude Include="OneWare.Terminal.dll"/>
    </ItemGroup>

    <Target Name="CreateWindowsCommandAlias" AfterTargets="Publish"
        Condition="'$(RuntimeIdentifier)' == 'win-x64' OR '$(RuntimeIdentifier)' == 'win-arm64'">
        <Copy SourceFiles="$(PublishDir)OneWareStudio.exe" DestinationFiles="$(PublishDir)oneware.exe"
            SkipUnchangedFiles="true"/>
    </Target>

    <!--
        Offline builds (Flatpak) cannot let GitHub.Copilot.SDK download the Copilot runtime. They pass the
        release archive (github-copilot-<CopilotCliVersion>-<platform>.tgz) with -p:CopilotRuntimeArchive=<path>,
        which is extracted into the SDK's cache so its own targets skip the download and bundle it as usual.
    -->
    <Target Name="UseProvidedCopilotRuntimeArchive" BeforeTargets="_DownloadCopilotCli"
        Condition="'$(CopilotRuntimeArchive)' != ''">
        <Error Condition="!Exists('$(CopilotRuntimeArchive)')"
            Text="CopilotRuntimeArchive '$(CopilotRuntimeArchive)' does not exist."/>
        <PropertyGroup>
            <_ProvidedCopilotCacheDir>$(IntermediateOutputPath)copilot-cli\$(CopilotCliVersion)\$(_CopilotPlatform)</_ProvidedCopilotCacheDir>
        </PropertyGroup>
        <RemoveDir Directories="$(_ProvidedCopilotCacheDir)"/>
        <MakeDir Directories="$(_ProvidedCopilotCacheDir)"/>
        <Exec Command="tar -xzf &quot;$(CopilotRuntimeArchive)&quot; --strip-components=1 -C &quot;$(_ProvidedCopilotCacheDir)&quot;"/>
        <WriteLinesToFile File="$(_ProvidedCopilotCacheDir)\.copilot-runtime-complete" Lines="$(CopilotCliVersion)"
            Overwrite="true"/>
    </Target>

</Project>
