<!--
    OneWare icon set.
    Monochrome icon geometries normalized to a 24x24 frame. Each geometry starts with two zero-area
    points at 0,0 and 24,24, so Path/PathIcon/GeometryDrawing stretching keeps a consistent padding
    and all icons have the same optical size. Icons follow the Foreground of their container.

    Usage:
        <PathIcon Data="{StaticResource Icon.Search}" />
        <PathIcon Classes="small muted" Data="{StaticResource Icon.Close}" />
        <Button Classes="icon"><PathIcon Data="{StaticResource Icon.Refresh}" /></Button>

    Multi-color icons (file types, status badges, debugger) remain DrawingImages in OneWare.Core.
    See docs/Styling.md.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

