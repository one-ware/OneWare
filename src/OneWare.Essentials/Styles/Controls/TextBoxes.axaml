<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Design.PreviewWith>
        <StackPanel Margin="20" Spacing="8" Width="240">
            <TextBox Watermark="Text" />
            <TextBox Classes="small" Watermark="Small" />
            <TextBox Classes="search" Watermark="Search...">
                <TextBox.InnerLeftContent>
                    <PathIcon Classes="small muted" Margin="4 0" Data="{StaticResource Icon.Search}" />
                </TextBox.InnerLeftContent>
            </TextBox>
            <TextBox AcceptsReturn="True" Height="60" Text="Multiline" />
            <NumericUpDown Value="3" />
        </StackPanel>
    </Design.PreviewWith>

    <Style Selector="TextBox">
        <Setter Property="Height" Value="{DynamicResource ThemeControlHeight}" />
        <Setter Property="Padding" Value="6 2" />
        <Setter Property="Background" Value="{DynamicResource ThemeControlMidBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderLowBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ThemeBorderThickness}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="{DynamicResource ThemeCornerRadius}" />
    </Style>

    <Style Selector="TextBox:pointerover /template/ Border#border">
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMidBrush}" />
    </Style>

    <Style Selector="TextBox:focus /template/ Border#border">
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
    </Style>

    <Style Selector="TextBox:error /template/ Border#border">
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
    </Style>

    <Style Selector="TextBox[AcceptsReturn=True], TextBox.MultilineTextBox, TextBox.multiline">
        <Setter Property="Height" Value="NaN" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>

    <Style Selector="TextBox.MultilineTextBox, TextBox.multiline">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Borderless text box (inline editing, embedded in other surfaces) -->
    <Style Selector="TextBox.bare">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Search field (see Controls/SearchBox): icons and actions go into InnerLeftContent / InnerRightContent -->
    <Style Selector="TextBox.search">
        <Setter Property="Padding" Value="2 0" />
    </Style>

    <Style Selector="TextBox.small">
        <Setter Property="Height" Value="{DynamicResource ThemeControlHeightSmall}" />
        <Setter Property="Padding" Value="4 1" />
    </Style>

    <Style Selector="NumericUpDown">
        <Setter Property="Height" Value="{DynamicResource ThemeControlHeight}" />
        <Setter Property="Padding" Value="6 0" />
        <Setter Property="CornerRadius" Value="{DynamicResource ThemeCornerRadius}" />
        <Setter Property="Background" Value="{DynamicResource ThemeControlMidBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderLowBrush}" />
    </Style>

    <Style Selector="NumericUpDown TextBox">
        <Setter Property="Height" Value="NaN" />
    </Style>

</Styles>
