<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Separator -->
    <Style Selector="Separator">
        <Setter Property="Background" Value="{DynamicResource ThemeBorderLowBrush}" />
    </Style>

    <!-- ToolTip -->
    <Style Selector="ToolTip">
        <Setter Property="CornerRadius" Value="{DynamicResource ThemeCornerRadius}" />
        <Setter Property="Padding" Value="8 4" />
        <Setter Property="MaxWidth" Value="600" />
        <Setter Property="Background" Value="{DynamicResource ThemeElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMidBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ThemeBorderThickness}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="ToolTip TextBlock">
        <Setter Property="TextWrapping" Value="WrapWithOverflow" />
    </Style>

    <!-- CheckBox / RadioButton -->
    <Style Selector="CheckBox">
        <Setter Property="CornerRadius" Value="{DynamicResource ThemeCornerRadiusSmall}" />
        <Setter Property="Background" Value="{DynamicResource ThemeControlMidBrush}" />
    </Style>

    <Style Selector="CheckBox:checked /template/ Border#border">
        <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
    </Style>

    <Style Selector="CheckBox:checked /template/ Path#checkMark">
        <Setter Property="Fill" Value="{DynamicResource HighlightForegroundBrush}" />
    </Style>

    <!-- Toolbar (aliases: ToolBar) -->
    <Style Selector="StackPanel.ToolBar, StackPanel.toolbar">
        <Setter Property="Spacing" Value="{DynamicResource ThemeSpacingSmall}" />
        <Setter Property="Height" Value="{DynamicResource ThemeControlHeight}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Orientation" Value="Horizontal" />
    </Style>

    <Style Selector="StackPanel.ToolBar > Separator, StackPanel.toolbar > Separator">
        <Setter Property="Margin" Value="2 0" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Width" Value="1" />
        <Setter Property="Background" Value="{DynamicResource ThemeBorderLowBrush}" />
    </Style>

    <Style Selector="StackPanel.ToolBar Button, StackPanel.toolbar Button">
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Height" Value="{DynamicResource ThemeControlHeight}" />
    </Style>

    <Style Selector="StackPanel.ToolBar TextBlock, StackPanel.toolbar TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Layout helpers -->
    <Style Selector="StackPanel.form">
        <Setter Property="Spacing" Value="{DynamicResource ThemeSpacing}" />
    </Style>

    <Style Selector="StackPanel.form-row">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="{DynamicResource ThemeSpacing}" />
    </Style>

    <Style Selector="StackPanel.form-row > TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="StackPanel.section">
        <Setter Property="Spacing" Value="{DynamicResource ThemeSpacingSmall}" />
    </Style>

    <!--
        Editor bar: contextual toolbar above an editor (EditView_Top extensions).
        <Border Classes="editor-bar">
            <WrapPanel Classes="editor-bar-items">
                <Button Classes="primary">...</Button>
                <StackPanel Classes="form-row"><TextBlock Text="Label" /><TextBox Width="160" /></StackPanel>
            </WrapPanel>
        </Border>
        Groups wrap onto new lines on narrow editors. Nested extensions can use their own
        WrapPanel.editor-bar-items, which then wraps inside the remaining width.
    -->
    <Style Selector="Border.editor-bar">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderLowBrush}" />
        <Setter Property="BorderThickness" Value="0 0 0 1" />
        <Setter Property="Padding" Value="6 4" />
    </Style>

    <Style Selector="WrapPanel.editor-bar-items">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="ItemSpacing" Value="{DynamicResource ThemeSpacingLarge}" />
        <Setter Property="LineSpacing" Value="{DynamicResource ThemeSpacingSmall}" />
    </Style>

    <Style Selector="WrapPanel.editor-bar-items > :is(Control)">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="WrapPanel.editor-bar-items StackPanel.form-row">
        <Setter Property="Spacing" Value="6" />
        <Setter Property="Height" Value="{DynamicResource ThemeControlHeight}" />
    </Style>

    <Style Selector="WrapPanel.editor-bar-items StackPanel.form-row > TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundLowBrush}" />
    </Style>

    <Style Selector="WrapPanel.editor-bar-items TextBlock.muted">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="StackPanel.page">
        <Setter Property="Spacing" Value="{DynamicResource ThemeSpacingLarge}" />
        <Setter Property="Margin" Value="{DynamicResource ThemePaddingXLarge}" />
    </Style>

    <Style Selector="StackPanel.spacing-small">
        <Setter Property="Spacing" Value="{DynamicResource ThemeSpacingSmall}" />
    </Style>

    <Style Selector="StackPanel.spacing">
        <Setter Property="Spacing" Value="{DynamicResource ThemeSpacing}" />
    </Style>

    <Style Selector="StackPanel.spacing-large">
        <Setter Property="Spacing" Value="{DynamicResource ThemeSpacingLarge}" />
    </Style>

</Styles>
