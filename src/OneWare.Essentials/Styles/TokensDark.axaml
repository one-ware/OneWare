<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Original OneWare dark palette. Surfaces: ControlLow (editors/lists) < ControlMid (inputs) < Background (panels) < Elevated (cards/popups) -->
    <Color x:Key="ThemeBackgroundColor">#FF303030</Color>
    <Color x:Key="ThemeBorderLowColor">#FF505050</Color>
    <Color x:Key="ThemeBorderMidColor">#FF808080</Color>
    <Color x:Key="ThemeBorderHighColor">#FFA0A0A0</Color>
    <Color x:Key="ThemeControlLowColor">#FF1E1E1E</Color>
    <Color x:Key="ThemeControlMidColor">#FF292929</Color>
    <Color x:Key="ThemeControlMidHighColor">#FF373737</Color>
    <Color x:Key="ThemeControlHighColor">#FF808080</Color>
    <Color x:Key="ThemeControlVeryHighColor">#FFEFEBEF</Color>
    <Color x:Key="ThemeControlHighlightLowColor">#88A8A8A8</Color>
    <Color x:Key="ThemeControlHighlightMidColor">#884C4C4C</Color>
    <Color x:Key="ThemeControlHighlightHighColor">#88505050</Color>
    <Color x:Key="ThemeForegroundColor">#FFD6D2D2</Color>
    <Color x:Key="ThemeForegroundLowColor">#FFB2B2B2</Color>
    <Color x:Key="ThemeEditorColor">#FFDEDEDE</Color>
    <Color x:Key="ThemeElevatedColor">#FF363636</Color>

    <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="{StaticResource ThemeBackgroundColor}" />
    <SolidColorBrush x:Key="ThemeBackgroundBrushOp" Color="{StaticResource ThemeBackgroundColor}" Opacity="0.9" />
    <SolidColorBrush x:Key="ThemeBorderLowBrush" Color="{StaticResource ThemeBorderLowColor}" />
    <SolidColorBrush x:Key="ThemeBorderMidBrush" Color="{StaticResource ThemeBorderMidColor}" />
    <SolidColorBrush x:Key="ThemeBorderHighBrush" Color="{StaticResource ThemeBorderHighColor}" />
    <SolidColorBrush x:Key="ThemeControlLowBrush" Color="{StaticResource ThemeControlLowColor}" />
    <SolidColorBrush x:Key="ThemeControlMidBrush" Color="{StaticResource ThemeControlMidColor}" />
    <SolidColorBrush x:Key="ThemeControlMidHighBrush" Color="{StaticResource ThemeControlMidHighColor}" />
    <SolidColorBrush x:Key="ThemeControlHighBrush" Color="{StaticResource ThemeControlHighColor}" />
    <SolidColorBrush x:Key="ThemeControlVeryHighBrush" Color="{StaticResource ThemeControlVeryHighColor}" />
    <SolidColorBrush x:Key="ThemeControlHighlightLowBrush" Color="{StaticResource ThemeControlHighlightLowColor}" />
    <SolidColorBrush x:Key="ThemeControlHighlightMidBrush" Color="{StaticResource ThemeControlHighlightMidColor}" />
    <SolidColorBrush x:Key="ThemeControlHighlightHighBrush" Color="{StaticResource ThemeControlHighlightHighColor}" />
    <SolidColorBrush x:Key="ThemeForegroundBrush" Color="{StaticResource ThemeForegroundColor}" />
    <SolidColorBrush x:Key="ThemeForegroundLowBrush" Color="{StaticResource ThemeForegroundLowColor}" />
    <SolidColorBrush x:Key="ThemeEditorBrush" Color="{StaticResource ThemeEditorColor}" />
    <SolidColorBrush x:Key="ThemeElevatedBrush" Color="{StaticResource ThemeElevatedColor}" />

    <!-- Secondary buttons are a raised surface (lighter than whatever they sit on) so they read the same size as the
         solid primary button. Translucent so they also stay visible on elevated cards and popups. -->
    <SolidColorBrush x:Key="ThemeButtonSecondaryBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="ThemeButtonSecondaryHoverBrush" Color="#444444" />

    <SolidColorBrush x:Key="EditorInputSurfaceBrush" Color="{StaticResource ThemeControlMidColor}" />
    <SolidColorBrush x:Key="EditorInputFooterBrush" Color="{StaticResource ThemeControlMidColor}" />

    <!-- Chat message/tool blocks -->
    <SolidColorBrush x:Key="ChatBubbleBrush" Color="{StaticResource ThemeControlMidColor}" />

    <SolidColorBrush x:Key="CaptionButtonForeground" Color="{StaticResource ThemeForegroundColor}" />
    <SolidColorBrush x:Key="CaptionButtonBackground" Color="{StaticResource ThemeBorderLowColor}" />
    <SolidColorBrush x:Key="CaptionButtonBorderBrush" Color="{StaticResource ThemeBorderLowColor}" />

    <SolidColorBrush x:Key="IconContrastColor" Color="#FF424040" />

    <SolidColorBrush x:Key="NotificationCardBackgroundBrush" Opacity="0.97" Color="{StaticResource ThemeElevatedColor}" />
    <SolidColorBrush x:Key="NotificationCardInformationBackgroundBrush" Opacity="0.97" Color="{StaticResource ThemeElevatedColor}" />

    <!-- From Fluent theme, prevents markdown crashes -->
    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="{DynamicResource ThemeAccentColor}" Opacity="0.3" />

</ResourceDictionary>
