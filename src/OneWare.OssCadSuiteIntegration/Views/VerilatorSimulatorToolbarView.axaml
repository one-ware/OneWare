<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:OneWare.OssCadSuiteIntegration.ViewModels"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="450"
             x:Class="OneWare.OssCadSuiteIntegration.Views.VerilatorSimulatorToolbarView"
             x:DataType="viewModels:VerilatorSimulatorToolbarViewModel">
    <StackPanel DockPanel.Dock="Left" Classes="ToolBar">
        <TextBlock Text="Top Module:" />
        <TextBox Width="140" Text="{Binding TopModule}" />
        <TextBlock Text="Verilator Arguments:" />
        <TextBox Width="220" Text="{Binding VerilatorArguments}" />
        <TextBlock Text="Runtime Arguments:" />
        <TextBox Width="180" Text="{Binding VerilatorRuntimeArguments}" />
    </StackPanel>
</UserControl>
