<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:OneWare.CloudIntegration.ViewModels"
             xmlns:controls="clr-namespace:OneWare.Essentials.Controls;assembly=OneWare.Essentials"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="OneWare.CloudIntegration.Views.OneWareCloudAccountFlyoutView"
             x:DataType="viewModels:OneWareCloudAccountFlyoutViewModel">

    <StackPanel Orientation="Horizontal" Spacing="5">
        <Button Command="{Binding OpenFeedbackDialogAsync}"
                CommandParameter="{Binding $self}" ToolTip.Tip="Feedback">
            <Button.Content>
                <Image Source="{DynamicResource Unicons.CommentMessage}" />
            </Button.Content>
        </Button>

        <Button Padding="1">
            <Button.Content>
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Left" ClipToBounds="True" CornerRadius="24">
                        <Panel>
                            <Image Source="{Binding SettingViewModel.Setting.Image}" />
                            <Image
                                IsVisible="{Binding  SettingViewModel.Setting.Image, FallbackValue={x:Null}, 
                            Converter={x:Static ObjectConverters.IsNull}}"
                                Source="{DynamicResource CodeIcons.Account}" Margin="2" />
                        </Panel>
                    </Border>
                </DockPanel>
            </Button.Content>
            <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterTheme="{StaticResource FlyoutNoPadding}"
                        Opened="OnFlyoutOpened">

                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" MinWidth="180" Margin="4" Spacing="2">

                        <TextBlock Text="OneWare Cloud" FontWeight="Bold" />

                        <ContentControl Content="{Binding SettingViewModel}" />

                        <Separator Margin="0" Padding="0" />

                        <!-- Logged In View -->
                        <StackPanel Orientation="Vertical" Spacing="5"
                                    IsVisible="{Binding CurrentAccountService.CurrentUser, Converter={x:Static ObjectConverters.IsNotNull}}">

                            <!-- Active organization -->
                            <StackPanel IsVisible="{Binding HasActiveOrganization}" Spacing="6" Margin="6,2"
                                        MinWidth="220">
                                <StackPanel>
                                    <TextBlock Text="{Binding OrganizationName}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" MaxWidth="240" />
                                    <TextBlock Text="{Binding OrganizationDetails}" FontSize="11"
                                               TextTrimming="CharacterEllipsis" MaxWidth="240"
                                               Foreground="{DynamicResource ThemeForegroundLowBrush}" />
                                    <TextBlock Text="{Binding PlanStatusText}" FontSize="11"
                                               IsVisible="{Binding ShowPlanStatus}"
                                               Foreground="{DynamicResource ThemeForegroundLowBrush}" />
                                </StackPanel>

                                <!-- Owners / administrators: Compute Credits total with its monthly allowance / prepaid split -->
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="2"
                                      IsVisible="{Binding ShowOrganizationCredits}">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Compute Credits"
                                               ToolTip.Tip="Used for training, AI Copilot and exports" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ComputeCreditsText}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Monthly allowance" Margin="10,0,0,0"
                                               FontSize="11" ToolTip.Tip="Included in the plan, used first, resets monthly"
                                               Foreground="{DynamicResource ThemeForegroundLowBrush}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding IncludedCreditsText}"
                                               FontSize="11" Foreground="{DynamicResource ThemeForegroundLowBrush}" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Prepaid" Margin="10,0,0,0"
                                               FontSize="11" ToolTip.Tip="Purchased, used after the monthly allowance, never expires"
                                               Foreground="{DynamicResource ThemeForegroundLowBrush}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PrepaidCreditsText}"
                                               FontSize="11" Foreground="{DynamicResource ThemeForegroundLowBrush}" />
                                </Grid>

                                <!-- Members: personal monthly budget -->
                                <StackPanel Spacing="3" IsVisible="{Binding ShowPersonalBudget}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Your Compute Credit budget"
                                                   Foreground="{DynamicResource ThemeForegroundLowBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding BudgetText}"
                                                   FontWeight="SemiBold" />
                                    </Grid>
                                    <ProgressBar IsVisible="{Binding HasBudgetLimit}" MinHeight="6"
                                                 Minimum="0" Maximum="{Binding BudgetLimit}"
                                                 Value="{Binding BudgetUsed}" />
                                    <TextBlock Text="{Binding BudgetHint}" FontSize="11"
                                               Foreground="{DynamicResource ThemeForegroundLowBrush}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                    <controls:HyperLink Label="Add Compute Credits"
                                                        Url="{Binding AddCreditsUrl}"
                                                        IsVisible="{Binding ShowOrganizationCredits}" />
                                    <controls:HyperLink Label="Upgrade to Pro"
                                                        Url="{Binding UpgradeUrl}"
                                                        IsVisible="{Binding ShowUpgrade}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock IsVisible="{Binding !HasActiveOrganization}"
                                       Text="No active organization" Margin="6,0"
                                       Foreground="{DynamicResource ThemeForegroundLowBrush}" />

                            <Separator Margin="0" Padding="0" />

                            <controls:HyperLink Label="Manage Account"
                                                Url="{Binding Url}"
                                                Margin="6,0, 6, 0"
                                                HorizontalContentAlignment="Center" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Logged Out View -->
                        <StackPanel Orientation="Vertical" Spacing="5"
                                    IsVisible="{Binding CurrentAccountService.CurrentUser, Converter={x:Static ObjectConverters.IsNull}}">
                            <controls:HyperLink Label="Register here"
                                                Url="{Binding Url}"
                                                Margin="6,0, 6, 0"
                                                HorizontalContentAlignment="Center" HorizontalAlignment="Center" />
                        </StackPanel>

                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>
    </StackPanel>

</UserControl>