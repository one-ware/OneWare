<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:OneWare.SourceControl.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="OneWare.SourceControl.Views.GitHubAccountSettingView"
             x:DataType="viewModels:GitHubAccountSettingViewModel">
    <Grid ColumnDefinitions="40, 5, *" RowDefinitions="20, 20" Margin="0 5">
        <Border ClipToBounds="True" Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                Background="{DynamicResource ThemeControlLowBrush}"
                CornerRadius="{DynamicResource ThemeCornerRadiusPill}">
            <Panel>
                <Image Source="{Binding Setting.Image}" />
                <PathIcon IsVisible="{Binding Setting.Image, Converter={x:Static ObjectConverters.IsNull}}"
                       Data="{StaticResource Icon.GitHub}"
                       Margin="6" />
            </Panel>
        </Border>
        <TextBlock Grid.Column="2" Grid.Row="0" Text="{Binding Setting.Username}" VerticalAlignment="Top" />
        <StackPanel Grid.Column="2" Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom">
            <Button IsVisible="{Binding !Setting.IsLoggedIn}" Command="{Binding LoginAsync}"
                    CommandParameter="{Binding $self}" Content="Login" Classes="secondary small" />
            <Button IsVisible="{Binding Setting.IsLoggedIn}" Command="{Binding Logout}" Content="Logout"
                    Classes="secondary small" />
        </StackPanel>
    </Grid>
</UserControl>