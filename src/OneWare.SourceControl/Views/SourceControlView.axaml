<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:libgit="clr-namespace:LibGit2Sharp;assembly=LibGit2Sharp"
             xmlns:models="clr-namespace:OneWare.SourceControl.Models"
             xmlns:viewModels="clr-namespace:OneWare.SourceControl.ViewModels"
             xmlns:converters="clr-namespace:OneWare.Essentials.Converters;assembly=OneWare.Essentials"
             xmlns:converters1="clr-namespace:OneWare.SourceControl.Converters"
             xmlns:controls="clr-namespace:OneWare.Essentials.Controls;assembly=OneWare.Essentials"
             xmlns:scControls="clr-namespace:OneWare.SourceControl.Controls"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="500"
             x:Class="OneWare.SourceControl.Views.SourceControlView"
             Name="SourceControlViewView" Background="{DynamicResource ThemeControlLowBrush}"
             x:DataType="viewModels:SourceControlViewModel" x:CompileBindings="True">

    <UserControl.Resources>
        <!-- File name plus dimmed directory, shared by all three change lists. -->
        <DataTemplate x:Key="FileRowContent" DataType="models:SourceControlFileModel">
            <DockPanel ToolTip.Tip="{Binding Status.FilePath}">
                <controls:LayeredIconPresenter DockPanel.Dock="Left" VerticalAlignment="Center"
                                               Margin="0, 0, 6, 0"
                                               Value="{Binding FileIcon}" Height="16" Width="16" />
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock VerticalAlignment="Center" Margin="6, 0, 0, 0" Classes="caption"
                           Text="{Binding RelativeDirectory}" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="ListBox">
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="22" />
        </Style>

        <!-- Row actions only show for the hovered or selected row, like the VS Code source control view. -->
        <Style Selector="ListBoxItem StackPanel.RowActions">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="ListBoxItem:pointerover StackPanel.RowActions">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="ListBoxItem:selected StackPanel.RowActions">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="Button.RowAction">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="Expander.Section">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Expander.Section /template/ ToggleButton#PART_toggle">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Expander.Section /template/ ToggleButton#PART_toggle /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <!-- Opacity instead of IsVisible so the header does not jump when the actions appear. -->
        <Style Selector="Expander.Section StackPanel.SectionActions">
            <Setter Property="Opacity" Value="0" />
        </Style>

        <Style Selector="Expander.Section:pointerover StackPanel.SectionActions">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- Graph: highlight only the commit line, not the expanded file list below it. -->
        <Style Selector="ListBox.Graph > ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>

        <Style Selector="ListBox.Graph > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ListBox.Graph > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ListBox.Graph DockPanel.CommitHeader, ListBox.Graph Grid.CommitFile">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ListBox.Graph DockPanel.CommitHeader:pointerover, ListBox.Graph Grid.CommitFile:pointerover">
            <Setter Property="Background" Value="{DynamicResource ThemeControlHighlightMidBrush}" />
        </Style>

        <Style Selector="ListBox.Graph > ListBoxItem:selected DockPanel.CommitHeader">
            <Setter Property="Background" Value="{DynamicResource ThemeControlHighlightMidBrush}" />
        </Style>

        <Style Selector="Grid.CommitFile StackPanel.RowActions">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="Grid.CommitFile:pointerover StackPanel.RowActions">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="ToggleButton.RowAction">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <Style Selector="Border.RefBadge">
            <Setter Property="Height" Value="16" />
            <Setter Property="Padding" Value="4 0" />
            <Setter Property="CornerRadius" Value="{DynamicResource ThemeCornerRadiusSmall}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMidBrush}" />
            <Setter Property="Background" Value="{DynamicResource ThemeControlMidBrush}" />
        </Style>

        <Style Selector="Border.RefBadge TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBadge}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.RefBadge.current">
            <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
        </Style>

        <Style Selector="Border.RefBadge.current TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource HighlightForegroundBrush}" />
        </Style>

        <Style Selector="Border.RefBadge.current PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource HighlightForegroundBrush}" />
        </Style>

        <Style Selector="Border.RefBadge.tag">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Border.CountBadge">
            <Setter Property="MinWidth" Value="18" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Padding" Value="5, 0" />
            <Setter Property="Margin" Value="6, 0, 2, 0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="30, *, Auto, Auto" Name="RootGrid">
        <Border Classes="header" Padding="0">
            <DockPanel LastChildFill="False">
                <Menu DockPanel.Dock="Right" Height="26" Width="26" Name="OptionsButton">
                    <MenuItem>
                        <MenuItem.Header>
                            <PathIcon VerticalAlignment="Center"
                                   Height="10"
                                   Width="10"
                                   Data="{StaticResource Icon.MoreVertical}" />
                        </MenuItem.Header>
                        <MenuItem Header="Account">
                            <MenuItem Header="Login to Github" Command="{Binding LoginGithubAsync}">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource Icon.GitHub}" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>
                        <MenuItem Header="Clone" Command="{Binding CloneDialogAsyncCommand}">
                            <MenuItem.Icon>
                                <PathIcon Data="{StaticResource Icon.Download}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Sync">
                            <MenuItem.Icon>
                                <PathIcon Data="{StaticResource Icon.RefreshSmall}" />
                            </MenuItem.Icon>
                            <MenuItem Header="Sync" Command="{Binding SyncAsyncCommand}"
                                      ToolTip.Tip="Pulls and Pushes changes" />
                            <MenuItem Header="Pull" Command="{Binding PullAsyncCommand}" />
                            <MenuItem Header="Push" Command="{Binding PushAsyncCommand}" />
                            <MenuItem Header="Fetch" Command="{Binding FetchAsyncCommand}" />
                        </MenuItem>
                        <MenuItem Header="Commit">
                            <MenuItem.Icon>
                                <PathIcon Data="{StaticResource Icon.GitCommit}" />
                            </MenuItem.Icon>
                            <MenuItem Header="Commit Staged" Command="{Binding CommitAsyncCommand}"
                                      CommandParameter="{x:True}"
                                      IsEnabled="{Binding CommitMessage.Length}" />
                            <MenuItem Header="Commit All" Command="{Binding CommitAsyncCommand}"
                                      CommandParameter="{x:False}"
                                      IsEnabled="{Binding CommitMessage.Length}" />
                        </MenuItem>
                        <MenuItem Header="Branches">
                            <MenuItem.Icon>
                                <PathIcon Data="{StaticResource Icon.GitBranch}" />
                            </MenuItem.Icon>
                            <MenuItem Header="Create Branch..." Command="{Binding CreateBranchDialogAsyncCommand}" />
                            <MenuItem Header="Merge Branch..." Command="{Binding MergeBranchDialogAsyncCommand}" />
                            <MenuItem Header="Delete Branch..." Command="{Binding DeleteBranchDialogAsyncCommand}" />
                        </MenuItem>
                        <MenuItem Header="Changes">
                            <MenuItem.Icon>
                                <PathIcon Data="{StaticResource Icon.GitCompare}" />
                            </MenuItem.Icon>
                            <MenuItem Header="Undo All Changes" Command="{Binding DiscardAllAsyncCommand}"
                                      CommandParameter="{x:Static libgit:ResetMode.Hard}">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource Icon.Undo}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Stage All" Command="{Binding StageAllCommand}" />
                            <MenuItem Header="Unstage All" Command="{Binding UnStageAllCommand}" />
                        </MenuItem>
                        <MenuItem Header="Remotes">
                            <MenuItem.Icon>
                                <PathIcon Data="{StaticResource Icon.Web}" />
                            </MenuItem.Icon>
                            <MenuItem Header="Add Remote..." Command="{Binding AddRemoteDialogAsyncCommand}" />
                            <MenuItem Header="Delete Remote..." Command="{Binding DeleteRemoteDialogAsyncCommand}" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Set Author Identity..." Command="{Binding SetUserIdentityAsyncCommand}"
                                  CommandParameter="{x:False}">
                            <MenuItem.Icon>
                                <PathIcon Data="{StaticResource Icon.Identity}" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                </Menu>
                <Button DockPanel.Dock="Right" Height="26" Width="26" Command="{Binding RefreshAsyncCommand}">
                    <PathIcon Data="{StaticResource Icon.RefreshSmall}" Width="15" ToolTip.Tip="Refresh" Height="15" />
                </Button>

                <Menu IsVisible="{Binding ActiveRepository.HeadBranch, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Name="BranchButton" ToolTip.Tip="{Binding ActiveRepository.WorkingPath}" Classes="BindMenu">
                    <MenuItem ItemsSource="{Binding ActiveRepository.AvailableBranchesMenu}">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock VerticalAlignment="Center" Height="20" Margin="1, 4, 3, 2"
                                           Text="{Binding ActiveRepository.HeadBranch.FriendlyName}" />
                                <PathIcon VerticalAlignment="Center"
                                       Height="13"
                                       Margin="3"
                                       Data="{StaticResource Icon.GitBranch}"
                                       Width="13" />
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                </Menu>
            </DockPanel>
        </Border>
        
        <!-- User operations show progress here instead of disabling the panel, background refreshes stay invisible. -->
        <ProgressBar Grid.Row="0" VerticalAlignment="Bottom" Height="2" MinWidth="0"
                     Background="Transparent" IsIndeterminate="True"
                     IsVisible="{Binding IsLoading}" />

        <Grid Grid.Row="1" RowDefinitions="*, Auto" MinHeight="120">
        <DockPanel Grid.Row="0" Margin="5">
            <StackPanel DockPanel.Dock="Top" Margin="15" Orientation="Vertical"
                        IsVisible="{Binding ActiveRepository.HeadBranch, Converter={x:Static ObjectConverters.IsNull}}">
                <TextBlock TextAlignment="Center"
                           Text="The currently active project doesn't have a git repository. You can initialize the currently active project as a new git repository"
                           TextWrapping="Wrap" />
                <Button
                    IsEnabled="{Binding ActiveRepository, Converter={x:Static ObjectConverters.IsNull}}"
                    Margin="0, 10, 0, 10" Width="180" Classes="RoundButton" Height="30"
                    Command="{Binding InitializeRepositoryCommand}">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Margin="0, 0, 10, 0"
                                   Height="15"
                                   VerticalAlignment="Center"
                                   Data="{StaticResource Icon.GitFork}"
                                   IsVisible="{Binding !InitializeRepositoryCommand.IsRunning}"
                                   Width="15" />
                            <controls:Spinner Width="14" Height="14" VerticalAlignment="Center"
                                              IsVisible="{Binding InitializeRepositoryCommand.IsRunning}" />
                            <TextBlock VerticalAlignment="Center" Text="Initialize Repository"
                                       IsVisible="{Binding !InitializeRepositoryCommand.IsRunning}" />
                            <TextBlock VerticalAlignment="Center" Text="Initializing..."
                                       IsVisible="{Binding InitializeRepositoryCommand.IsRunning}" />
                        </StackPanel>
                    </Button.Content>
                </Button>

                <TextBlock Margin="0, 20, 0, 0" Text="Alternatively you can clone an existing repository"
                           TextWrapping="Wrap" TextAlignment="Center" />

                <Button Margin="0, 10, 0, 10" Width="180" Classes="RoundButton"
                        Height="30"
                        Command="{Binding CloneDialogAsyncCommand}">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <PathIcon Margin="0, 0, 10, 0"
                                   Height="15"
                                   VerticalAlignment="Center"
                                   Data="{StaticResource Icon.Download}"
                                   Width="15" />
                            <TextBlock Text="Clone existing Repository" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button.Content>
                </Button>

                <!--
                <StackPanel Margin="0, 10, 0, 0" Orientation="Horizontal">
                    <TextBlock Text="Learn how to use the Team Explorer " />
                    <controls:HyperLink Url="https://one-ware/docs/studio/features/teamexplorer" Label="here"
                                        HorizontalAlignment="Left" />
                </StackPanel>
                -->
            </StackPanel>
            <Expander DockPanel.Dock="Top" Classes="Section" IsExpanded="True"
                      IsVisible="{Binding ActiveRepository.MergeChanges.Count, FallbackValue={x:False}}">
                <Expander.Header>
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="Merge Changes" />
                        <Border DockPanel.Dock="Right" Classes="badge CountBadge">
                            <TextBlock Classes="caption" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="{Binding ActiveRepository.MergeChanges.Count}" />
                        </Border>
                    </DockPanel>
                </Expander.Header>
                <ListBox ItemsSource="{Binding ActiveRepository.MergeChanges}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         BorderThickness="0" MaxHeight="220"
                         Name="MergeChangeListBox">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="models:SourceControlFileModel">
                            <Grid ColumnDefinitions="*, Auto, Auto" Margin="14, 0, 4, 0" Height="22">
                                <ContentControl VerticalAlignment="Center" Content="{Binding}"
                                                ContentTemplate="{StaticResource FileRowContent}" />
                                <StackPanel Grid.Column="1" Classes="RowActions" Orientation="Horizontal" Spacing="1"
                                            VerticalAlignment="Center" Margin="4, 0">
                                    <Button Classes="RowAction" ToolTip.Tip="Accept Changes / Stage"
                                            Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).StageCommand, FallbackValue={x:Null}}"
                                            CommandParameter="{Binding Status.FilePath}">
                                        <PathIcon Data="{StaticResource Icon.Accept}" Width="13" Height="13" />
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Width="12" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Classes="bold"
                                           ToolTip.Tip="{Binding Status.State, Converter={x:Static converters:SharedConverters.EnumToStringConverter}}"
                                           Text="{Binding Status.State, Converter={x:Static converters1:SourceControlConverters.ChangeStatusCharConverter}}"
                                           Foreground="{Binding Status.State, Converter={x:Static converters1:SourceControlConverters.ChangeStatusBrushConverter}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu x:DataType="models:SourceControlFileModel">
                                        <MenuItem Header="Accept Changes / Stage"
                                                  IsEnabled="{Binding Status.State, Converter={x:Static converters:SharedConverters.ComparisonConverter}, ConverterParameter={x:Static libgit:FileStatus.Conflicted}}"
                                                  Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).StageCommand, FallbackValue={x:Null}}"
                                                  CommandParameter="{Binding Status.FilePath}">
                                            <MenuItem.Icon>
                                                <PathIcon Data="{StaticResource Icon.Accept}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Open File"
                                                  Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).OpenFileAsync}"
                                                  CommandParameter="{Binding Status.FilePath}" />
                                        <Separator />
                                        <MenuItem Header="Accept All Current"
                                                  IsEnabled="{Binding Status.State, Converter={x:Static converters:SharedConverters.ComparisonConverter}, ConverterParameter={x:Static libgit:FileStatus.Conflicted}}"
                                                  Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).MergeAcceptCurrentAsync}"
                                                  CommandParameter="{Binding Status.FilePath}" />
                                        <MenuItem Header="Accept All Incoming"
                                                  IsEnabled="{Binding Status.State, Converter={x:Static converters:SharedConverters.ComparisonConverter}, ConverterParameter={x:Static libgit:FileStatus.Conflicted}}"
                                                  Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).MergeAcceptIncomingAsync}"
                                                  CommandParameter="{Binding Status.FilePath}" />
                                        <Separator />
                                        <MenuItem Header="View in Project Explorer"
                                                  Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).ViewInProjectExplorer}"
                                                  CommandParameter="{Binding FullPath}" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Styles>
                </ListBox>
            </Expander>

            <Expander DockPanel.Dock="Top" Classes="Section" IsExpanded="True"
                      IsVisible="{Binding ActiveRepository.StagedChanges.Count, FallbackValue={x:False}}">
                <Expander.Header>
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="Staged Changes" />
                        <Border DockPanel.Dock="Right" Classes="badge CountBadge">
                            <TextBlock Classes="caption" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="{Binding ActiveRepository.StagedChanges.Count}" />
                        </Border>
                        <StackPanel DockPanel.Dock="Right" Classes="SectionActions" Orientation="Horizontal"
                                    Spacing="1" VerticalAlignment="Center">
                            <Button Classes="RowAction" ToolTip.Tip="Unstage All Changes"
                                    Command="{Binding UnStageAllCommand}">
                                <PathIcon Data="{StaticResource Icon.Remove}" Width="13" Height="13" />
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Expander.Header>
                <ListBox ItemsSource="{Binding ActiveRepository.StagedChanges}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0"
                         MaxHeight="220"
                         Name="StagedChangeListBox">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="models:SourceControlFileModel">
                            <Grid ColumnDefinitions="*, Auto, Auto" Margin="14, 0, 4, 0" Height="22">
                                <ContentControl VerticalAlignment="Center" Content="{Binding}"
                                                ContentTemplate="{StaticResource FileRowContent}" />
                                <StackPanel Grid.Column="1" Classes="RowActions" Orientation="Horizontal" Spacing="1"
                                            VerticalAlignment="Center" Margin="4, 0">
                                    <Button Classes="RowAction" ToolTip.Tip="Compare Staged Changes with HEAD"
                                            Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).CompareStagedAndSwitch, FallbackValue={x:Null}}"
                                            CommandParameter="{Binding Status.FilePath}">
                                        <Image Source="{DynamicResource VsImageLib.Compare16X}" Width="13" Height="13" />
                                    </Button>
                                    <Button Classes="RowAction" ToolTip.Tip="Unstage Changes"
                                            Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).UnStageCommand, FallbackValue={x:Null}}"
                                            CommandParameter="{Binding Status.FilePath}">
                                        <PathIcon Data="{StaticResource Icon.Remove}" Width="13" Height="13" />
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Width="12" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Classes="bold"
                                           ToolTip.Tip="{Binding Status.State, Converter={x:Static converters:SharedConverters.EnumToStringConverter}}"
                                           Text="{Binding Status.State, Converter={x:Static converters1:SourceControlConverters.ChangeStatusCharConverter}}"
                                           Foreground="{Binding Status.State, Converter={x:Static converters1:SourceControlConverters.ChangeStatusBrushConverter}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu x:DataType="models:SourceControlFileModel">
                                        <MenuItem Header="Compare Staged Changes with HEAD"
                                                  Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).CompareStagedAndSwitch}"
                                                  CommandParameter="{Binding Status.FilePath}">
                                            <MenuItem.Icon>
                                                <Image Source="{DynamicResource VsImageLib.Compare16X}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <!-- <MenuItem Header="View Changes" -->
                                        <!--           IsEnabled="{Binding Status.State, Converter={x:Static converters:SharedConverters.ComparisonConverter}, ConverterParameter={x:Static libgit:FileStatus.ModifiedInWorkdir}}" -->
                                        <!--           Command="{Binding Source={StaticResource maindock}, Path=SourceControl.ViewChanges}" -->
                                        <!--           CommandParameter="{Binding Status.FilePath}" /> -->
                                        <MenuItem Header="Open File"
                                                  Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).OpenFileAsync}"
                                                  CommandParameter="{Binding Status.FilePath}" />
                                        <MenuItem Header="Open File (Head)"
                                                  Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).OpenHeadFileAsync}"
                                                  CommandParameter="{Binding Status.FilePath}" />
                                        <Separator />
                                        <MenuItem Header="Unstage Changes"
                                                  Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).UnStage}"
                                                  CommandParameter="{Binding Status.FilePath}" />
                                        <Separator />
                                        <MenuItem Header="View in Project Explorer"
                                                  Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).ViewInProjectExplorer}"
                                                  CommandParameter="{Binding FullPath}" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Styles>
                </ListBox>
            </Expander>

            <Expander Classes="Section" IsExpanded="True"
                      IsVisible="{Binding ActiveRepository.HeadBranch, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue={x:False}}">
                <Expander.Header>
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="Changes" />
                        <Border DockPanel.Dock="Right" Classes="badge CountBadge">
                            <TextBlock Classes="caption" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="{Binding ActiveRepository.Changes.Count}" />
                        </Border>
                        <StackPanel DockPanel.Dock="Right" Classes="SectionActions" Orientation="Horizontal"
                                    Spacing="1" VerticalAlignment="Center">
                            <Button Classes="RowAction" ToolTip.Tip="Discard All Changes"
                                    Command="{Binding DiscardAllAsyncCommand}"
                                    CommandParameter="{x:Static libgit:ResetMode.Hard}">
                                <PathIcon Data="{StaticResource Icon.Reset}" Width="13" Height="13" />
                            </Button>
                            <Button Classes="RowAction" ToolTip.Tip="Stage All Changes"
                                    Command="{Binding StageAllCommand}">
                                <PathIcon Data="{StaticResource Icon.Add}" Width="13" Height="13" />
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Expander.Header>
                <ListBox ItemsSource="{Binding ActiveRepository.Changes}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         BorderThickness="0"
                         Name="ChangeListBox">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="models:SourceControlFileModel">
                            <Grid ColumnDefinitions="*, Auto, Auto" Margin="14, 0, 4, 0" Height="22">
                                <ContentControl VerticalAlignment="Center" Content="{Binding}"
                                                ContentTemplate="{StaticResource FileRowContent}" />
                                <StackPanel Grid.Column="1" Classes="RowActions" Orientation="Horizontal" Spacing="1"
                                            VerticalAlignment="Center" Margin="4, 0">
                                    <Button Classes="RowAction" ToolTip.Tip="Undo Changes"
                                            Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).DiscardAsync, FallbackValue={x:Null}}"
                                            CommandParameter="{Binding Status.FilePath}">
                                        <PathIcon Data="{StaticResource Icon.Reset}" Width="13" Height="13" />
                                    </Button>
                                    <Button Classes="RowAction" ToolTip.Tip="Stage Changes"
                                            Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).StageCommand, FallbackValue={x:Null}}"
                                            CommandParameter="{Binding Status.FilePath}">
                                        <PathIcon Data="{StaticResource Icon.Add}" Width="13" Height="13" />
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Width="12" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Classes="bold"
                                           ToolTip.Tip="{Binding Status.State, Converter={x:Static converters:SharedConverters.EnumToStringConverter}}"
                                           Text="{Binding Status.State, Converter={x:Static converters1:SourceControlConverters.ChangeStatusCharConverter}}"
                                           Foreground="{Binding Status.State, Converter={x:Static converters1:SourceControlConverters.ChangeStatusBrushConverter}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="ContextMenu" x:DataType="models:SourceControlFileModel">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Header="Compare Changes with Index"
                                                  Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).CompareAndSwitch}"
                                                  CommandParameter="{Binding Status.FilePath}">
                                            <MenuItem.Icon>
                                                <Image Source="{DynamicResource VsImageLib.Compare16X}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <!-- <MenuItem Header="View Changes" -->
                                        <!--           IsEnabled="{Binding Status.State, Converter={x:Static converters:SharedConverters.ComparisonConverter}, ConverterParameter={x:Static libgit:FileStatus.ModifiedInWorkdir}}" -->
                                        <!--           Command="{Binding Source={StaticResource maindock}, Path=SourceControl.ViewChanges}" -->
                                        <!--           CommandParameter="{Binding Status.FilePath}" /> -->
                                        <MenuItem Header="Open File"
                                                  Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).OpenFileAsync}"
                                                  CommandParameter="{Binding Status.FilePath}" />
                                        <MenuItem Header="Open File (Head)"
                                                  Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).OpenHeadFileAsync}"
                                                  CommandParameter="{Binding Status.FilePath}" />
                                        <Separator />
                                        <MenuItem Header="Stage Changes"
                                                  Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).Stage}"
                                                  CommandParameter="{Binding Status.FilePath}" />
                                        <MenuItem Header="Undo Changes"
                                                  Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).DiscardAsync}"
                                                  CommandParameter="{Binding Status.FilePath}">
                                            <MenuItem.Icon>
                                                <PathIcon Data="{StaticResource Icon.Undo}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="View in Project Explorer"
                                                  Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).ViewInProjectExplorer}"
                                                  CommandParameter="{Binding FullPath}" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Styles>
                </ListBox>
            </Expander>
        </DockPanel>

        <Border Grid.Row="1" Margin="10 6 10 8"
                Background="{DynamicResource EditorInputSurfaceBrush}"
                Classes="RoundBorder">
            <Grid RowDefinitions="Auto, Auto">
                <TextBox Classes="bare"
                    IsEnabled="{Binding ActiveRepository.HeadBranch, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Text="{Binding CommitMessage}" Name="CommitMessageBox"
                    Watermark="Describe your changes..." Padding="10 10 10 8"
                    AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52"
                    VerticalContentAlignment="Top" />

                <Border Grid.Row="1" Background="{DynamicResource EditorInputFooterBrush}"
                        BorderThickness="0 1 0 0"
                        CornerRadius="0 0 3 3" Padding="6 4">
                    <DockPanel Height="24" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                                   Classes="caption"
                                   Text="{Binding ActiveRepository.HeadBranch.FriendlyName, FallbackValue=No repository}" />

                        <Button DockPanel.Dock="Right" Command="{Binding CommitAsyncCommand}"
                                Classes="RoundButton PrimaryButton" Padding="8 0"
                                IsEnabled="{Binding #CommitMessageBox.Text.Length}"
                                CommandParameter="{x:True}"
                                IsVisible="{Binding ActiveRepository.StagedChanges.Count, FallbackValue={x:True}}"
                                ToolTip.Tip="Commit staged changes">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="{StaticResource Icon.Accept}" Width="13" Height="13" />
                                <TextBlock Text="Commit Staged" />
                            </StackPanel>
                        </Button>

                        <Button DockPanel.Dock="Right" Command="{Binding CommitAsyncCommand}"
                                Classes="RoundButton PrimaryButton" Padding="8 0"
                                IsEnabled="{Binding #CommitMessageBox.Text.Length}"
                                CommandParameter="{x:False}"
                                IsVisible="{Binding !ActiveRepository.StagedChanges.Count, FallbackValue={x:False}}"
                                ToolTip.Tip="Stage all changes and commit">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="{StaticResource Icon.Accept}" Width="13" Height="13" />
                                <TextBlock Text="Commit" />
                            </StackPanel>
                        </Button>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>        </Grid>

        <GridSplitter Grid.Row="2" Name="GraphSplitter" Height="5" MinHeight="5" ResizeDirection="Rows"
                      Background="Transparent" BorderThickness="0 1 0 0"
                      BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                      IsVisible="{Binding #GraphSection.IsExpanded}" />

        <Expander Grid.Row="3" Name="GraphSection" Classes="Section" IsExpanded="True" Margin="5 0 5 5"
                  VerticalContentAlignment="Stretch"
                  IsVisible="{Binding ActiveRepository.HeadBranch, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue={x:False}}">
            <Expander.Header>
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="Graph" />
                    <StackPanel DockPanel.Dock="Right" Classes="SectionActions" Orientation="Horizontal"
                                Spacing="1" VerticalAlignment="Center">
                        <ToggleButton Classes="RowAction" IsChecked="{Binding GraphShowAllBranches}"
                                      ToolTip.Tip="Show All Branches">
                            <PathIcon Data="{StaticResource Icon.GitFork}" Width="13" Height="13" />
                        </ToggleButton>
                        <Button Classes="RowAction" ToolTip.Tip="Fetch" Command="{Binding FetchAsyncCommand}">
                            <PathIcon Data="{StaticResource Icon.Cloud}" Width="13" Height="13" />
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Expander.Header>
            <ListBox Name="GraphListBox" Classes="Graph" ItemsSource="{Binding ActiveRepository.History, FallbackValue={x:Null}}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0"
                     Background="Transparent" SelectionMode="Single">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="models:GitGraphRow">
                        <Grid RowDefinitions="22, Auto">
                            <DockPanel Classes="CommitHeader" ToolTip.Tip="{Binding ToolTip}">
                                <DockPanel.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Copy Commit ID"
                                                  Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).CopyToClipboardAsync, FallbackValue={x:Null}}"
                                                  CommandParameter="{Binding Commit.Sha}">
                                            <MenuItem.Icon>
                                                <PathIcon Data="{StaticResource Icon.Copy}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Copy Commit Message"
                                                  Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).CopyToClipboardAsync, FallbackValue={x:Null}}"
                                                  CommandParameter="{Binding Commit.Message}" />
                                    </ContextMenu>
                                </DockPanel.ContextMenu>
                                <scControls:GitGraphCell DockPanel.Dock="Left" Row="{Binding}" Margin="2 0 4 0"
                                                         NodeBackground="{DynamicResource ThemeControlLowBrush}" />
                                <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Refs}" Margin="4 0 4 0"
                                              IsVisible="{Binding HasRefs}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="3" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="models:GitRefInfo">
                                            <Border Classes="RefBadge" Classes.current="{Binding IsCurrent}"
                                                    Classes.tag="{Binding Kind, Converter={x:Static converters1:SourceControlConverters.IsTagConverter}}"
                                                    ToolTip.Tip="{Binding Name}">
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <PathIcon Width="10" Height="10"
                                                              Data="{Binding Kind, Converter={x:Static converters1:SourceControlConverters.RefKindIconConverter}}" />
                                                    <TextBlock Text="{Binding Name}" MaxWidth="120"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Commit.MessageShort}" />
                                    <Run Text="  " />
                                    <Run Text="{Binding Commit.AuthorName}"
                                         Foreground="{DynamicResource ThemeForegroundLowBrush}" />
                                </TextBlock>
                            </DockPanel>

                            <DockPanel Grid.Row="1" IsVisible="{Binding IsExpanded}">
                                <scControls:GitGraphCell DockPanel.Dock="Left" Row="{Binding}" IsContinuation="True"
                                                         Margin="2 0 4 0" VerticalAlignment="Stretch" />
                                <StackPanel>
                                    <TextBlock Classes="caption" Margin="4 3" Text="{Binding AuthorAndDate}" />
                                    <TextBlock Classes="caption" Margin="4 3" Text="Loading..."
                                               IsVisible="{Binding IsLoadingFiles}" />
                                    <ItemsControl ItemsSource="{Binding Files}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="models:GitCommitFileModel">
                                                <Grid Classes="CommitFile" ColumnDefinitions="*, Auto, Auto" Height="22"
                                                      ToolTip.Tip="{Binding Path}">
                                                    <Grid.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Open Changes"
                                                                      Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).CompareCommitFile, FallbackValue={x:Null}}"
                                                                      CommandParameter="{Binding}">
                                                                <MenuItem.Icon>
                                                                    <Image Source="{DynamicResource VsImageLib.Compare16X}" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Open File at Revision"
                                                                      Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).OpenCommitFileAsync, FallbackValue={x:Null}}"
                                                                      CommandParameter="{Binding}" />
                                                            <MenuItem Header="Open File"
                                                                      Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).OpenFileAsync, FallbackValue={x:Null}}"
                                                                      CommandParameter="{Binding FullPath}" />
                                                        </ContextMenu>
                                                    </Grid.ContextMenu>
                                                    <DockPanel Margin="4 0 0 0">
                                                        <controls:LayeredIconPresenter DockPanel.Dock="Left" VerticalAlignment="Center"
                                                                                       Margin="0, 0, 6, 0" Value="{Binding FileIcon}"
                                                                                       Height="16" Width="16" />
                                                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                                                                   Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock VerticalAlignment="Center" Margin="6, 0, 0, 0" Classes="caption"
                                                                   Text="{Binding RelativeDirectory}" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                    <StackPanel Grid.Column="1" Classes="RowActions" Orientation="Horizontal"
                                                                Spacing="1" VerticalAlignment="Center" Margin="4, 0">
                                                        <Button Classes="RowAction" ToolTip.Tip="Open File at Revision"
                                                                Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).OpenCommitFileAsync, FallbackValue={x:Null}}"
                                                                CommandParameter="{Binding}">
                                                            <PathIcon Data="{StaticResource Icon.File}" Width="13" Height="13" />
                                                        </Button>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Width="12" Margin="0 0 4 0"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" Classes="bold"
                                                               ToolTip.Tip="{Binding Status}"
                                                               Text="{Binding Status, Converter={x:Static converters1:SourceControlConverters.ChangeStatusCharConverter}}"
                                                               Foreground="{Binding Status, Converter={x:Static converters1:SourceControlConverters.ChangeStatusBrushConverter}}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Expander>
    </Grid>
</UserControl>
