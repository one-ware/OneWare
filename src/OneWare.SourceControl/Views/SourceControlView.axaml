<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:libgit="clr-namespace:LibGit2Sharp;assembly=LibGit2Sharp"
             xmlns:models="clr-namespace:OneWare.SourceControl.Models"
             xmlns:viewModels="clr-namespace:OneWare.SourceControl.ViewModels"
             xmlns:converters="clr-namespace:OneWare.Essentials.Converters;assembly=OneWare.Essentials"
             xmlns:converters1="clr-namespace:OneWare.SourceControl.Converters"
             xmlns:controls="clr-namespace:OneWare.Essentials.Controls;assembly=OneWare.Essentials"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="500"
             x:Class="OneWare.SourceControl.Views.SourceControlView"
             Name="SourceControlViewView" Background="{DynamicResource ThemeControlLowBrush}"
             x:DataType="viewModels:SourceControlViewModel" x:CompileBindings="True">

    <UserControl.Resources>
        <!-- File name plus dimmed directory, shared by all three change lists. -->
        <DataTemplate x:Key="FileRowContent" DataType="models:SourceControlFileModel">
            <DockPanel ToolTip.Tip="{Binding Status.FilePath}">
                <controls:LayeredIconPresenter DockPanel.Dock="Left" VerticalAlignment="Center"
                                               Margin="0, 0, 6, 0"
                                               Value="{Binding FileIcon}" Height="16" Width="16" />
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="{Binding Name}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock VerticalAlignment="Center" Margin="6, 0, 0, 0" FontSize="11"
                           Text="{Binding RelativeDirectory}" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource ThemeForegroundLowBrush}" />
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="ListBox">
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="22" />
        </Style>

        <!-- Row actions only show for the hovered or selected row, like the VS Code source control view. -->
        <Style Selector="ListBoxItem StackPanel.RowActions">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="ListBoxItem:pointerover StackPanel.RowActions">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="ListBoxItem:selected StackPanel.RowActions">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="Button.RowAction">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>

        <Style Selector="Expander.Section">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Expander.Section /template/ ToggleButton#PART_toggle">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style Selector="Expander.Section /template/ ToggleButton#PART_toggle /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <!-- Opacity instead of IsVisible so the header does not jump when the actions appear. -->
        <Style Selector="Expander.Section StackPanel.SectionActions">
            <Setter Property="Opacity" Value="0" />
        </Style>

        <Style Selector="Expander.Section:pointerover StackPanel.SectionActions">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Border.CountBadge">
            <Setter Property="Background" Value="{DynamicResource ThemeControlHighBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="MinWidth" Value="18" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Padding" Value="5, 0" />
            <Setter Property="Margin" Value="6, 0, 2, 0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="30, *, Auto">
        <Border Background="{DynamicResource ThemeBackgroundBrush}" BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                BorderThickness="0 0 0 1">
            <DockPanel LastChildFill="False">
                <Menu DockPanel.Dock="Right" Height="26" Width="26" Name="OptionsButton">
                    <MenuItem>
                        <MenuItem.Header>
                            <Image VerticalAlignment="Center" Height="10" Width="10"
                                   Source="{DynamicResource BoxIcons.RegularDotsVerticalRounded}" />
                        </MenuItem.Header>
                        <MenuItem Header="Account">
                            <MenuItem Header="Login to Github" Command="{Binding LoginGithubAsync}">
                                <MenuItem.Icon>
                                    <Image Source="{DynamicResource Bootstrap.Github}" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuItem>
                        <MenuItem Header="Clone" Command="{Binding CloneDialogAsyncCommand}">
                            <MenuItem.Icon>
                                <Image Source="{DynamicResource FontAwesome.DownloadSolid}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Sync">
                            <MenuItem.Icon>
                                <Image Source="{DynamicResource VsImageLib.RefreshGrey16X}" />
                            </MenuItem.Icon>
                            <MenuItem Header="Sync" Command="{Binding SyncAsyncCommand}"
                                      ToolTip.Tip="Pulls and Pushes changes" />
                            <MenuItem Header="Pull" Command="{Binding PullAsyncCommand}" />
                            <MenuItem Header="Push" Command="{Binding PushAsyncCommand}" />
                            <MenuItem Header="Fetch" Command="{Binding FetchAsyncCommand}" />
                        </MenuItem>
                        <MenuItem Header="Commit">
                            <MenuItem.Icon>
                                <Image Source="{DynamicResource BoxIcons.RegularGitCommit}" />
                            </MenuItem.Icon>
                            <MenuItem Header="Commit Staged" Command="{Binding CommitAsyncCommand}"
                                      CommandParameter="{x:True}"
                                      IsEnabled="{Binding CommitMessage.Length}" />
                            <MenuItem Header="Commit All" Command="{Binding CommitAsyncCommand}"
                                      CommandParameter="{x:False}"
                                      IsEnabled="{Binding CommitMessage.Length}" />
                        </MenuItem>
                        <MenuItem Header="Branches">
                            <MenuItem.Icon>
                                <Image Source="{DynamicResource BoxIcons.RegularGitBranch}" />
                            </MenuItem.Icon>
                            <MenuItem Header="Create Branch..." Command="{Binding CreateBranchDialogAsyncCommand}" />
                            <MenuItem Header="Merge Branch..." Command="{Binding MergeBranchDialogAsyncCommand}" />
                            <MenuItem Header="Delete Branch..." Command="{Binding DeleteBranchDialogAsyncCommand}" />
                        </MenuItem>
                        <MenuItem Header="Changes">
                            <MenuItem.Icon>
                                <Image Source="{DynamicResource BoxIcons.RegularGitCompare}" />
                            </MenuItem.Icon>
                            <MenuItem Header="Undo All Changes" Command="{Binding DiscardAllAsyncCommand}"
                                      CommandParameter="{x:Static libgit:ResetMode.Hard}">
                                <MenuItem.Icon>
                                    <Image Source="{DynamicResource VsImageLib.Undo16X}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Stage All" Command="{Binding StageAllCommand}" />
                            <MenuItem Header="Unstage All" Command="{Binding UnStageAllCommand}" />
                        </MenuItem>
                        <MenuItem Header="Remotes">
                            <MenuItem.Icon>
                                <Image Source="{DynamicResource Material.Web}" />
                            </MenuItem.Icon>
                            <MenuItem Header="Add Remote..." Command="{Binding AddRemoteDialogAsyncCommand}" />
                            <MenuItem Header="Delete Remote..." Command="{Binding DeleteRemoteDialogAsyncCommand}" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Set Author Identity..." Command="{Binding SetUserIdentityAsyncCommand}"
                                  CommandParameter="{x:False}">
                            <MenuItem.Icon>
                                <Image Source="{DynamicResource MaterialDesign.PermIdentity}" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                </Menu>
                <Button DockPanel.Dock="Right" Height="26" Width="26" Command="{Binding RefreshAsyncCommand}">
                    <Image Source="{DynamicResource VsImageLib.RefreshGrey16X}" Width="15" ToolTip.Tip="Refresh" />
                </Button>

                <Menu IsEnabled="{Binding !IsLoading}"
                    IsVisible="{Binding ActiveRepository.HeadBranch, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Name="BranchButton" ToolTip.Tip="{Binding ActiveRepository.WorkingPath}" Classes="BindMenu">
                    <MenuItem ItemsSource="{Binding ActiveRepository.AvailableBranchesMenu}">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock VerticalAlignment="Center" Height="20" Margin="1, 4, 3, 2"
                                           Text="{Binding ActiveRepository.HeadBranch.FriendlyName}" />
                                <Image VerticalAlignment="Center" Height="13" Margin="3"
                                       Source="{DynamicResource BoxIcons.RegularGitBranch}" />
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                </Menu>
            </DockPanel>
        </Border>
        
        <DockPanel Grid.Row="1" Margin="5" IsEnabled="{Binding !IsLoading}">
            <StackPanel DockPanel.Dock="Top" Margin="15" Orientation="Vertical"
                        IsVisible="{Binding ActiveRepository.HeadBranch, Converter={x:Static ObjectConverters.IsNull}}">
                <TextBlock TextAlignment="Center"
                           Text="The currently active project doesn't have a git repository. You can initialize the currently active project as a new git repository"
                           TextWrapping="Wrap" />
                <Button
                    IsEnabled="{Binding ActiveRepository, Converter={x:Static ObjectConverters.IsNull}}"
                    Margin="0, 10, 0, 10" Width="180" Classes="RoundButton" Height="30"
                    Command="{Binding InitializeRepositoryCommand}">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Image Margin="0, 0, 10, 0" Height="15" VerticalAlignment="Center"
                                   Source="{DynamicResource BoxIcons.RegularGitRepoForked}"
                                   IsVisible="{Binding !InitializeRepositoryCommand.IsRunning}" />
                            <controls:Spinner Width="14" Height="14" VerticalAlignment="Center"
                                              IsVisible="{Binding InitializeRepositoryCommand.IsRunning}" />
                            <TextBlock VerticalAlignment="Center" Text="Initialize Repository"
                                       IsVisible="{Binding !InitializeRepositoryCommand.IsRunning}" />
                            <TextBlock VerticalAlignment="Center" Text="Initializing..."
                                       IsVisible="{Binding InitializeRepositoryCommand.IsRunning}" />
                        </StackPanel>
                    </Button.Content>
                </Button>

                <TextBlock Margin="0, 20, 0, 0" Text="Alternatively you can clone an existing repository"
                           TextWrapping="Wrap" TextAlignment="Center" />

                <Button Margin="0, 10, 0, 10" Width="180" Classes="RoundButton"
                        Height="30"
                        Command="{Binding CloneDialogAsyncCommand}">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <Image Margin="0, 0, 10, 0" Height="15" VerticalAlignment="Center"
                                   Source="{DynamicResource FontAwesome.DownloadSolid}" />
                            <TextBlock Text="Clone existing Repository" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button.Content>
                </Button>

                <!--
                <StackPanel Margin="0, 10, 0, 0" Orientation="Horizontal">
                    <TextBlock Text="Learn how to use the Team Explorer " />
                    <controls:HyperLink Url="https://one-ware/docs/studio/features/teamexplorer" Label="here"
                                        HorizontalAlignment="Left" />
                </StackPanel>
                -->
            </StackPanel>
            <Expander DockPanel.Dock="Top" Classes="Section" IsExpanded="True"
                      IsVisible="{Binding ActiveRepository.MergeChanges.Count, FallbackValue={x:False}}">
                <Expander.Header>
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="Merge Changes" />
                        <Border DockPanel.Dock="Right" Classes="CountBadge">
                            <TextBlock FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="{Binding ActiveRepository.MergeChanges.Count}" />
                        </Border>
                    </DockPanel>
                </Expander.Header>
                <ListBox ItemsSource="{Binding ActiveRepository.MergeChanges}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         BorderThickness="0" MaxHeight="220"
                         Name="MergeChangeListBox">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="models:SourceControlFileModel">
                            <Grid ColumnDefinitions="*, Auto, Auto" Margin="14, 0, 4, 0" Height="22">
                                <ContentControl VerticalAlignment="Center" Content="{Binding}"
                                                ContentTemplate="{StaticResource FileRowContent}" />
                                <StackPanel Grid.Column="1" Classes="RowActions" Orientation="Horizontal" Spacing="1"
                                            VerticalAlignment="Center" Margin="4, 0">
                                    <Button Classes="RowAction" ToolTip.Tip="Accept Changes / Stage"
                                            Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).StageCommand, FallbackValue={x:Null}}"
                                            CommandParameter="{Binding Status.FilePath}">
                                        <Image Source="{DynamicResource PicolIcons.Accept}" Width="13" Height="13" />
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Width="12" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" FontWeight="Bold"
                                           ToolTip.Tip="{Binding Status.State, Converter={x:Static converters:SharedConverters.EnumToStringConverter}}"
                                           Text="{Binding Status.State, Converter={x:Static converters1:SourceControlConverters.ChangeStatusCharConverter}}"
                                           Foreground="{Binding Status.State, Converter={x:Static converters1:SourceControlConverters.ChangeStatusBrushConverter}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu x:DataType="models:SourceControlFileModel">
                                        <MenuItem Header="Accept Changes / Stage"
                                                  IsEnabled="{Binding Status.State, Converter={x:Static converters:SharedConverters.ComparisonConverter}, ConverterParameter={x:Static libgit:FileStatus.Conflicted}}"
                                                  Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).StageCommand, FallbackValue={x:Null}}"
                                                  CommandParameter="{Binding Status.FilePath}">
                                            <MenuItem.Icon>
                                                <Image Source="{DynamicResource PicolIcons.Accept}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="Open File"
                                                  Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).OpenFileAsync}"
                                                  CommandParameter="{Binding Status.FilePath}" />
                                        <Separator />
                                        <MenuItem Header="Accept All Current"
                                                  IsEnabled="{Binding Status.State, Converter={x:Static converters:SharedConverters.ComparisonConverter}, ConverterParameter={x:Static libgit:FileStatus.Conflicted}}"
                                                  Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).MergeAcceptCurrentAsync}"
                                                  CommandParameter="{Binding Status.FilePath}" />
                                        <MenuItem Header="Accept All Incoming"
                                                  IsEnabled="{Binding Status.State, Converter={x:Static converters:SharedConverters.ComparisonConverter}, ConverterParameter={x:Static libgit:FileStatus.Conflicted}}"
                                                  Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).MergeAcceptIncomingAsync}"
                                                  CommandParameter="{Binding Status.FilePath}" />
                                        <Separator />
                                        <MenuItem Header="View in Project Explorer"
                                                  Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).ViewInProjectExplorer}"
                                                  CommandParameter="{Binding FullPath}" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Styles>
                </ListBox>
            </Expander>

            <Expander DockPanel.Dock="Top" Classes="Section" IsExpanded="True"
                      IsVisible="{Binding ActiveRepository.StagedChanges.Count, FallbackValue={x:False}}">
                <Expander.Header>
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="Staged Changes" />
                        <Border DockPanel.Dock="Right" Classes="CountBadge">
                            <TextBlock FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="{Binding ActiveRepository.StagedChanges.Count}" />
                        </Border>
                        <StackPanel DockPanel.Dock="Right" Classes="SectionActions" Orientation="Horizontal"
                                    Spacing="1" VerticalAlignment="Center">
                            <Button Classes="RowAction" ToolTip.Tip="Unstage All Changes"
                                    Command="{Binding UnStageAllCommand}">
                                <Image Source="{DynamicResource BoxIcons.RegularMinus}" Width="13" Height="13" />
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Expander.Header>
                <ListBox ItemsSource="{Binding ActiveRepository.StagedChanges}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0"
                         MaxHeight="220"
                         Name="StagedChangeListBox">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="models:SourceControlFileModel">
                            <Grid ColumnDefinitions="*, Auto, Auto" Margin="14, 0, 4, 0" Height="22">
                                <ContentControl VerticalAlignment="Center" Content="{Binding}"
                                                ContentTemplate="{StaticResource FileRowContent}" />
                                <StackPanel Grid.Column="1" Classes="RowActions" Orientation="Horizontal" Spacing="1"
                                            VerticalAlignment="Center" Margin="4, 0">
                                    <Button Classes="RowAction" ToolTip.Tip="Compare Staged Changes with HEAD"
                                            Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).CompareStagedAndSwitch, FallbackValue={x:Null}}"
                                            CommandParameter="{Binding Status.FilePath}">
                                        <Image Source="{DynamicResource VsImageLib.Compare16X}" Width="13" Height="13" />
                                    </Button>
                                    <Button Classes="RowAction" ToolTip.Tip="Unstage Changes"
                                            Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).UnStageCommand, FallbackValue={x:Null}}"
                                            CommandParameter="{Binding Status.FilePath}">
                                        <Image Source="{DynamicResource BoxIcons.RegularMinus}" Width="13" Height="13" />
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Width="12" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" FontWeight="Bold"
                                           ToolTip.Tip="{Binding Status.State, Converter={x:Static converters:SharedConverters.EnumToStringConverter}}"
                                           Text="{Binding Status.State, Converter={x:Static converters1:SourceControlConverters.ChangeStatusCharConverter}}"
                                           Foreground="{Binding Status.State, Converter={x:Static converters1:SourceControlConverters.ChangeStatusBrushConverter}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu x:DataType="models:SourceControlFileModel">
                                        <MenuItem Header="Compare Staged Changes with HEAD"
                                                  Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).CompareStagedAndSwitch}"
                                                  CommandParameter="{Binding Status.FilePath}">
                                            <MenuItem.Icon>
                                                <Image Source="{DynamicResource VsImageLib.Compare16X}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <!-- <MenuItem Header="View Changes" -->
                                        <!--           IsEnabled="{Binding Status.State, Converter={x:Static converters:SharedConverters.ComparisonConverter}, ConverterParameter={x:Static libgit:FileStatus.ModifiedInWorkdir}}" -->
                                        <!--           Command="{Binding Source={StaticResource maindock}, Path=SourceControl.ViewChanges}" -->
                                        <!--           CommandParameter="{Binding Status.FilePath}" /> -->
                                        <MenuItem Header="Open File"
                                                  Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).OpenFileAsync}"
                                                  CommandParameter="{Binding Status.FilePath}" />
                                        <MenuItem Header="Open File (Head)"
                                                  Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).OpenHeadFileAsync}"
                                                  CommandParameter="{Binding Status.FilePath}" />
                                        <Separator />
                                        <MenuItem Header="Unstage Changes"
                                                  Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).UnStage}"
                                                  CommandParameter="{Binding Status.FilePath}" />
                                        <Separator />
                                        <MenuItem Header="View in Project Explorer"
                                                  Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).ViewInProjectExplorer}"
                                                  CommandParameter="{Binding FullPath}" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Styles>
                </ListBox>
            </Expander>

            <Expander Classes="Section" IsExpanded="True"
                      IsVisible="{Binding ActiveRepository.HeadBranch, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue={x:False}}">
                <Expander.Header>
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="Changes" />
                        <Border DockPanel.Dock="Right" Classes="CountBadge">
                            <TextBlock FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="{Binding ActiveRepository.Changes.Count}" />
                        </Border>
                        <StackPanel DockPanel.Dock="Right" Classes="SectionActions" Orientation="Horizontal"
                                    Spacing="1" VerticalAlignment="Center">
                            <Button Classes="RowAction" ToolTip.Tip="Discard All Changes"
                                    Command="{Binding DiscardAllAsyncCommand}"
                                    CommandParameter="{x:Static libgit:ResetMode.Hard}">
                                <Image Source="{DynamicResource BoxIcons.RegularReset}" Width="13" Height="13" />
                            </Button>
                            <Button Classes="RowAction" ToolTip.Tip="Stage All Changes"
                                    Command="{Binding StageAllCommand}">
                                <Image Source="{DynamicResource BoxIcons.RegularPlus}" Width="13" Height="13" />
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Expander.Header>
                <ListBox ItemsSource="{Binding ActiveRepository.Changes}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         BorderThickness="0"
                         Name="ChangeListBox">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="models:SourceControlFileModel">
                            <Grid ColumnDefinitions="*, Auto, Auto" Margin="14, 0, 4, 0" Height="22">
                                <ContentControl VerticalAlignment="Center" Content="{Binding}"
                                                ContentTemplate="{StaticResource FileRowContent}" />
                                <StackPanel Grid.Column="1" Classes="RowActions" Orientation="Horizontal" Spacing="1"
                                            VerticalAlignment="Center" Margin="4, 0">
                                    <Button Classes="RowAction" ToolTip.Tip="Undo Changes"
                                            Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).DiscardAsync, FallbackValue={x:Null}}"
                                            CommandParameter="{Binding Status.FilePath}">
                                        <Image Source="{DynamicResource BoxIcons.RegularReset}" Width="13" Height="13" />
                                    </Button>
                                    <Button Classes="RowAction" ToolTip.Tip="Stage Changes"
                                            Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).StageCommand, FallbackValue={x:Null}}"
                                            CommandParameter="{Binding Status.FilePath}">
                                        <Image Source="{DynamicResource BoxIcons.RegularPlus}" Width="13" Height="13" />
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Width="12" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" FontWeight="Bold"
                                           ToolTip.Tip="{Binding Status.State, Converter={x:Static converters:SharedConverters.EnumToStringConverter}}"
                                           Text="{Binding Status.State, Converter={x:Static converters1:SourceControlConverters.ChangeStatusCharConverter}}"
                                           Foreground="{Binding Status.State, Converter={x:Static converters1:SourceControlConverters.ChangeStatusBrushConverter}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="ContextMenu" x:DataType="models:SourceControlFileModel">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Header="Compare Changes with Index"
                                                  Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).CompareAndSwitch}"
                                                  CommandParameter="{Binding Status.FilePath}">
                                            <MenuItem.Icon>
                                                <Image Source="{DynamicResource VsImageLib.Compare16X}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <!-- <MenuItem Header="View Changes" -->
                                        <!--           IsEnabled="{Binding Status.State, Converter={x:Static converters:SharedConverters.ComparisonConverter}, ConverterParameter={x:Static libgit:FileStatus.ModifiedInWorkdir}}" -->
                                        <!--           Command="{Binding Source={StaticResource maindock}, Path=SourceControl.ViewChanges}" -->
                                        <!--           CommandParameter="{Binding Status.FilePath}" /> -->
                                        <MenuItem Header="Open File"
                                                  Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).OpenFileAsync}"
                                                  CommandParameter="{Binding Status.FilePath}" />
                                        <MenuItem Header="Open File (Head)"
                                                  Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).OpenHeadFileAsync}"
                                                  CommandParameter="{Binding Status.FilePath}" />
                                        <Separator />
                                        <MenuItem Header="Stage Changes"
                                                  Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).Stage}"
                                                  CommandParameter="{Binding Status.FilePath}" />
                                        <MenuItem Header="Undo Changes"
                                                  Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).DiscardAsync}"
                                                  CommandParameter="{Binding Status.FilePath}">
                                            <MenuItem.Icon>
                                                <Image Source="{DynamicResource VsImageLib.Undo16X}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="View in Project Explorer"
                                                  Command="{Binding #SourceControlViewView.((viewModels:SourceControlViewModel)DataContext).ViewInProjectExplorer}"
                                                  CommandParameter="{Binding FullPath}" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.Styles>
                </ListBox>
            </Expander>
        </DockPanel>

        <Border Grid.Row="2" Margin="10 6 10 8"
            IsEnabled="{Binding !IsLoading}"
                Background="{DynamicResource EditorInputSurfaceBrush}"
                Classes="RoundBorder">
            <Grid RowDefinitions="Auto, Auto">
                <TextBox
                    IsEnabled="{Binding ActiveRepository.HeadBranch, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Text="{Binding CommitMessage}" Name="CommitMessageBox"
                    BorderThickness="0" Background="Transparent"
                    Watermark="Describe your changes..." Padding="10 10 10 8"
                    AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52"
                    VerticalContentAlignment="Top" />

                <Border Grid.Row="1" Background="{DynamicResource EditorInputFooterBrush}"
                        BorderThickness="0 1 0 0" Padding="6 4">
                    <DockPanel Height="24" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ThemeForegroundLowBrush}" FontSize="11"
                                   Text="{Binding ActiveRepository.HeadBranch.FriendlyName, FallbackValue=No repository}" />

                        <Button DockPanel.Dock="Right" Command="{Binding CommitAsyncCommand}"
                                Classes="RoundButton PrimaryButton" Padding="8 0"
                                IsEnabled="{Binding #CommitMessageBox.Text.Length}"
                                CommandParameter="{x:True}"
                                IsVisible="{Binding ActiveRepository.StagedChanges.Count, FallbackValue={x:True}}"
                                ToolTip.Tip="Commit staged changes">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Image Source="{DynamicResource PicolIcons.Accept}" Width="13" Height="13" />
                                <TextBlock Text="Commit Staged" />
                            </StackPanel>
                        </Button>

                        <Button DockPanel.Dock="Right" Command="{Binding CommitAsyncCommand}"
                                Classes="RoundButton PrimaryButton" Padding="8 0"
                                IsEnabled="{Binding #CommitMessageBox.Text.Length}"
                                CommandParameter="{x:False}"
                                IsVisible="{Binding !ActiveRepository.StagedChanges.Count, FallbackValue={x:False}}"
                                ToolTip.Tip="Stage all changes and commit">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Image Source="{DynamicResource PicolIcons.Accept}" Width="13" Height="13" />
                                <TextBlock Text="Commit" />
                            </StackPanel>
                        </Button>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>