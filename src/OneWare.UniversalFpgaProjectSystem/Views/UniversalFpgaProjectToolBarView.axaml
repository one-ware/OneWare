<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:OneWare.UniversalFpgaProjectSystem.ViewModels"
             xmlns:controls="clr-namespace:OneWare.Essentials.Controls;assembly=OneWare.Essentials"
             mc:Ignorable="d" IsVisible="{Binding IsVisible}"
             x:Class="OneWare.UniversalFpgaProjectSystem.Views.UniversalFpgaProjectToolBarView"
             x:DataType="viewModels:UniversalFpgaProjectToolBarViewModel">

    <StackPanel Classes="toolbar">
        <Separator />
        <StackPanel Classes="split">
            <Button ToolTip.Tip="Constraint Editor"
                    Command="{Binding OpenPinPlannerAsync}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Image Source="{DynamicResource CreateIcon}" Width="14" Height="14" VerticalAlignment="Center" />
                    <TextBlock Text="Constraints" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Classes="menu" ToolTip.Tip="Constraint options">
                <Button.Flyout>
                    <Flyout FlyoutPresenterClasses="list">
                        <StackPanel>
                            <MenuItem Header="Project Settings"
                                      Command="{Binding OpenProjectSettingsAsync}">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource Icon.Settings}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <controls:UiExtensionCollection
                                Context="{Binding $parent[UserControl].((viewModels:UniversalFpgaProjectToolBarViewModel)DataContext).Project, FallbackValue={x:Null}}"
                                Extensions="{Binding PinPlannerMenuExtension}">
                                <controls:UiExtensionCollection.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </controls:UiExtensionCollection.ItemsPanel>
                            </controls:UiExtensionCollection>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
                <PathIcon Data="{StaticResource Icon.MoreVertical}" Width="10" Height="10" />
            </Button>
        </StackPanel>
        <Separator />
        <StackPanel Classes="split">
            <Button ToolTip.Tip="Run Toolchain" Command="{Binding CompileAsync}"
                    IsEnabled="{Binding Project.Toolchain, FallbackValue={x:Null}, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Classes="success small" Data="{StaticResource Icon.Play}" />
                    <TextBlock Text="Compile" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Classes="menu" ToolTip.Tip="Toolchain options">
                <Button.Flyout>
                    <Flyout FlyoutPresenterClasses="list">
                        <StackPanel>
                            <controls:UiExtensionCollection
                                Context="{Binding $parent[UserControl].((viewModels:UniversalFpgaProjectToolBarViewModel)DataContext).Project, FallbackValue={x:Null}}"
                                Extensions="{Binding CompileMenuExtension}">
                                <controls:UiExtensionCollection.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </controls:UiExtensionCollection.ItemsPanel>
                            </controls:UiExtensionCollection>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
                <PathIcon Data="{StaticResource Icon.ChevronDown}" Width="10" Height="10" />
            </Button>
        </StackPanel>
        <Separator />
        <StackPanel Classes="split">
            <Button ToolTip.Tip="Configures the FPGA or writes the FLASH memory" Command="{Binding DownloadAsync}"
                    IsEnabled="{Binding Project.Loader, FallbackValue={x:Null}, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Panel VerticalAlignment="Center">
                        <PathIcon Classes="accent small" IsVisible="{Binding !LongTermProgramming}"
                                  Data="{StaticResource Icon.Download}" />
                        <PathIcon Classes="accent small" IsVisible="{Binding LongTermProgramming}"
                                  Data="{StaticResource Icon.DownloadTray}" />
                    </Panel>
                    <TextBlock Text="Config FPGA" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Classes="menu" ToolTip.Tip="Programming options">
                <Button.Flyout>
                    <Flyout FlyoutPresenterClasses="list">
                        <StackPanel Orientation="Vertical">
                            <MenuItem Header="Write FLASH Memory"
                                      Command="{Binding $parent[UserControl].((viewModels:UniversalFpgaProjectToolBarViewModel)DataContext).ToggleLongTermProgramming, FallbackValue={x:Null}}"
                                      CommandParameter="{Binding}">
                                <MenuItem.Icon>
                                    <CheckBox BorderThickness="0" IsChecked="{Binding LongTermProgramming}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <controls:UiExtensionCollection
                                Context="{Binding $parent[UserControl].((viewModels:UniversalFpgaProjectToolBarViewModel)DataContext).Project, FallbackValue={x:Null}}"
                                Extensions="{Binding DownloaderConfigurationExtension}">
                                <controls:UiExtensionCollection.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical" />
                                    </ItemsPanelTemplate>
                                </controls:UiExtensionCollection.ItemsPanel>
                            </controls:UiExtensionCollection>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
                <PathIcon Data="{StaticResource Icon.MoreVertical}" Width="10" Height="10" />
            </Button>
        </StackPanel>
    </StackPanel>

</UserControl>