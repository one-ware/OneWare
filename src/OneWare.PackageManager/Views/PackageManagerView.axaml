<controls:FlexibleWindow xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:OneWare.PackageManager.ViewModels"
    xmlns:views="clr-namespace:OneWare.PackageManager.Views"
    xmlns:controls="clr-namespace:OneWare.Essentials.Controls;assembly=OneWare.Essentials"
    xmlns:behaviors="clr-namespace:OneWare.Essentials.Behaviors;assembly=OneWare.Essentials"
    x:Class="OneWare.PackageManager.Views.PackageManagerView" x:DataType="vm:PackageManagerViewModel"
    PrefWidth="1050" PrefHeight="700" MinWidth="800" Title="Package Manager"
    CustomIcon="{DynamicResource PackageManager}" WindowStartupLocation="CenterOwner">
    <Grid Margin="20" RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <Grid IsVisible="{Binding !IsDetails}" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBox Name="PackageSearch" Height="44" Text="{Binding Filter, Mode=TwoWay}"
                     Watermark="Search packages…" AutomationProperties.Name="Search packages" VerticalContentAlignment="Center" />
            <Button Grid.Column="1" Content="Clear" Command="{Binding ClearSearchCommand}" AutomationProperties.Name="Clear search" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="Refresh" Command="{Binding RefreshPackagesAsync}" IsEnabled="{Binding !IsLoading}" />
                <Button Content="Sources" Click="Sources_OnClick" />
            </StackPanel>
        </Grid>
        <Button Name="BackButton" IsVisible="{Binding IsDetails}" Content="← Back to packages" Command="{Binding BackCommand}" HorizontalAlignment="Left" />
        <!-- Keep browse controls alive while details are open to preserve scroll/filter state. -->
        <Grid Grid.Row="1" IsVisible="{Binding !IsDetails}" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="12">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <controls:SegmentedControl SelectedIndex="{Binding SelectedFilterIndex, Mode=TwoWay}">
                    <controls:SegmentedControlItem Content="Discover" />
                    <controls:SegmentedControlItem Content="Installed" />
                    <controls:SegmentedControlItem Content="{Binding UpdatesLabel}" />
                </controls:SegmentedControl>
                <ComboBox Grid.Column="1" HorizontalAlignment="Right" MinWidth="160" ItemsSource="{Binding CategoryFilters}"
                          SelectedItem="{Binding CategoryFilter, Mode=TwoWay}" AutomationProperties.Name="Package type or category" />
                <Button Grid.Column="2" Content="Update All" IsVisible="{Binding IsUpdates}" Command="{Binding UpdateAllCommand}" />
            </Grid>
            <Border Grid.Row="1" IsVisible="{Binding SourceWarning, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Background="{DynamicResource ThemeControlLowBrush}" Padding="10" CornerRadius="6">
                <TextBlock Text="{Binding SourceWarning}" TextWrapping="Wrap" />
            </Border>
            <StackPanel Grid.Row="2" IsVisible="{Binding ShowFeatured}" Spacing="8">
                <TextBlock Text="Featured by OneWare" FontSize="18" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding FeaturedPackages}" MaxHeight="230">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PackageViewModel">
                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16" Margin="0,0,8,6"
                                    Background="{DynamicResource ThemeControlLowBrush}" Click="Details_OnClick">
                                <Grid ColumnDefinitions="56,*" ColumnSpacing="12">
                                    <Interaction.Behaviors><behaviors:CommandOnAttachedToVisualTreeBehavior Command="{Binding ResolveIconCommand}" /></Interaction.Behaviors>
                                    <Panel Width="56" Height="56">
                                        <TextBlock Text="□" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding Image, Converter={x:Static ObjectConverters.IsNull}}" />
                                        <Image Source="{Binding Image}" />
                                    </Panel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="{Binding PackageState.Package.Name}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" />
                                        <TextBlock Text="{Binding PackageState.Package.Description}" TextWrapping="Wrap" MaxLines="2" />
                                        <TextBlock Text="{Binding PackageState.Status}" Foreground="{DynamicResource ThemeForegroundLowBrush}" />
                                        <TextBlock Text="View details →" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding ResultsLabel}" Foreground="{DynamicResource ThemeForegroundLowBrush}" />
                <controls:Spinner Grid.Column="1" Height="18" Width="18" IsVisible="{Binding IsLoading}" />
            </Grid>
            <Grid Grid.Row="4">
                <ListBox Name="PluginList" ItemsSource="{Binding BrowsePackages}" Background="Transparent" BorderThickness="0"
                         AutomationProperties.Name="Packages"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" DoubleTapped="PluginList_OnDoubleTapped" KeyDown="PluginList_OnKeyDown">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:PackageViewModel">
                            <Grid ColumnDefinitions="52,*,Auto" ColumnSpacing="12" Margin="4,8">
                                <Interaction.Behaviors><behaviors:CommandOnAttachedToVisualTreeBehavior Command="{Binding ResolveIconCommand}" /></Interaction.Behaviors>
                                <Panel Width="42" Height="42">
                                    <TextBlock Text="□" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding Image, Converter={x:Static ObjectConverters.IsNull}}" />
                                    <Image Source="{Binding Image}" />
                                </Panel>
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="{Binding PackageState.Package.Name}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding PackageState.Package.Description}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{Binding PackageState.Package.Category}" Foreground="{DynamicResource ThemeForegroundLowBrush}" />
                                        <TextBlock Text="{Binding PackageState.Status}" Foreground="{DynamicResource ThemeForegroundLowBrush}" />
                                        <TextBlock Text="{Binding PackageState.InstalledVersion.Version, FallbackValue=''}" />
                                    </StackPanel>
                                    <ProgressBar Value="{Binding PackageState.Progress}" Maximum="1" Height="3" IsVisible="{Binding IsInstalling}" IsIndeterminate="{Binding PackageState.IsIndeterminate}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="{Binding PrimaryButtonText}" Command="{Binding MainButtonCommand}" CommandParameter="{Binding $self}" IsEnabled="{Binding MainButtonCommand, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    <Button Content="Details" Click="Details_OnClick" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" IsVisible="{Binding ShowEmptyState}">
                    <TextBlock Text="No matching packages" FontSize="18" />
                    <Button Content="Reset filters" Command="{Binding ResetFiltersCommand}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
        <Border Grid.Row="1" IsVisible="{Binding IsDetails}">
            <views:PackageView DataContext="{Binding SelectedPackage}" />
        </Border>
        <Border Grid.Row="2" IsVisible="{Binding RestartRequired}" Padding="10" Background="{DynamicResource ThemeControlLowBrush}">
            <TextBlock Text="Restart required to apply plugin changes." />
        </Border>
    </Grid>
</controls:FlexibleWindow>
