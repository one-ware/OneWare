<controls:FlexibleWindow xmlns="https://github.com/avaloniaui"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:viewModels="clr-namespace:OneWare.PackageManager.ViewModels"
                         xmlns:controls="clr-namespace:OneWare.Essentials.Controls;assembly=OneWare.Essentials"
                         xmlns:behaviors="clr-namespace:OneWare.Essentials.Behaviors;assembly=OneWare.Essentials"
                         PrefWidth="1050" PrefHeight="600"
                         mc:Ignorable="d"
                         x:Class="OneWare.PackageManager.Views.PackageManagerView"
                         CustomIcon="{DynamicResource PackageManager}"
                         Title="Extensions" Name="PackageManagerViewView"
                         x:CompileBindings="True" x:DataType="viewModels:PackageManagerViewModel"
                         WindowStartupLocation="CenterOwner">

    <controls:FlexibleWindow.Styles>
        <Style Selector="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="10 6" />
            <Setter Property="Margin" Value="0 2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </controls:FlexibleWindow.Styles>

    <Grid RowDefinitions="Auto,*">
        <Border Padding="10" BorderThickness="0 1 0 1">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <Border Classes="RoundToolBar" Margin="0 0 10 0">
                    <controls:SearchBox SearchText="{Binding Filter}" SearchButtonVisible="False"
                                        Label="Search packages" />
                </Border>
                <ComboBox Grid.Column="1" Width="240" Margin="0 0 10 0"
                          ItemsSource="{Binding CategoryOptions}"
                          SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                          ToolTip.Tip="Filter by category">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:PackageCategoryViewModel">
                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="2" Margin="0 0 10 0" VerticalAlignment="Center"
                        IsEnabled="{Binding !IsLoading}" Command="{Binding RefreshPackagesAsync}"
                        ToolTip.Tip="Refresh packages">
                    <Image Height="16" Width="16" Source="{DynamicResource VsImageLib.RefreshGrey16X}" />
                </Button>
                <Button Grid.Column="3" Classes="RoundButton" VerticalAlignment="Center"
                        IsEnabled="{Binding !IsLoading}" Command="{Binding UpdateAllCommand}" Padding="10 5">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Update All" />
                        <Image Height="14" Width="14" Source="{DynamicResource VsImageLib.Download16X}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="3*,6,2*">
            <Grid Background="{DynamicResource ThemeBackgroundBrush}" MinWidth="350">
                <ListBox Name="PluginList" Margin="4"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutoScrollToSelectedItem="True"
                         Background="Transparent" BorderThickness="0"
                         SelectedItem="{Binding SelectedPackage, Mode=TwoWay}"
                         ItemsSource="{Binding VisiblePackages}">
                    <Interaction.Behaviors>
                        <EventTriggerBehavior EventName="SelectionChanged">
                            <InvokeCommandAction Command="{Binding ResolveSelectedPackageTabsAsync}" />
                        </EventTriggerBehavior>
                    </Interaction.Behaviors>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:PackageViewModel">
                            <Grid ColumnDefinitions="48,*,132" Height="76">
                                <Interaction.Behaviors>
                                    <behaviors:CommandOnAttachedToVisualTreeBehavior
                                        Command="{Binding ResolveIconCommand}" />
                                </Interaction.Behaviors>
                                <Grid Margin="0 0 8 0">
                                    <Image Source="{Binding Image}" Width="36" Height="36"
                                           IsVisible="{Binding Image, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                    <controls:Spinner Width="24" Height="24"
                                                      IsVisible="{Binding Image, Converter={x:Static ObjectConverters.IsNull}}" />
                                </Grid>
                                <Grid Grid.Column="1" RowDefinitions="24,24,20" Margin="0 0 8 0"
                                      VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PackageState.Package.Name}"
                                               FontSize="14" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="1" Text="{Binding PackageState.Package.Description}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource ThemeForegroundLowBrush}" />
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                   Foreground="{DynamicResource ThemeForegroundLowBrush}" />
                                        <TextBlock Text="{Binding PackageState.InstalledVersion.Version, FallbackValue={}}"
                                                   FontSize="11" Foreground="{DynamicResource ThemeForegroundLowBrush}" />
                                        <Image Source="{DynamicResource VsImageLib.StatusWarning16X}" Width="12" Height="12"
                                               IsVisible="{Binding PackageState.InstalledVersionWarningText, Converter={x:Static ObjectConverters.IsNotNull}}"
                                               ToolTip.Tip="{Binding PackageState.InstalledVersionWarningText}" />
                                    </StackPanel>
                                </Grid>
                                <Button Grid.Column="2" Content="{Binding PrimaryButtonText}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Classes="RoundButton" Padding="8 4"
                                        Background="{Binding PrimaryButtonBrush}"
                                        Command="{Binding MainButtonCommand}" CommandParameter="{Binding $self}">
                                    <Interaction.Behaviors>
                                        <ButtonClickEventTriggerBehavior>
                                            <ChangePropertyAction TargetObject="PluginList" PropertyName="SelectedItem"
                                                                  Value="{Binding}" />
                                        </ButtonClickEventTriggerBehavior>
                                    </Interaction.Behaviors>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="No packages match your search or category." Margin="20"
                           TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource ThemeForegroundLowBrush}"
                           IsVisible="{Binding HasNoResults}" />
                <controls:Spinner Height="24" Width="24" VerticalAlignment="Center" HorizontalAlignment="Center"
                                  IsVisible="{Binding IsLoading}" />
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          BorderThickness="1 0 0 0" BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                          Background="{DynamicResource ThemeBackgroundBrush}" />

            <Grid Grid.Column="2" Margin="10" MinWidth="280">
                <ContentPresenter Content="{Binding SelectedPackage}" />
                <TextBlock Text="Select a package to see its details." TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource ThemeForegroundLowBrush}"
                           IsVisible="{Binding SelectedPackage, Converter={x:Static ObjectConverters.IsNull}}" />
            </Grid>
        </Grid>
    </Grid>
</controls:FlexibleWindow>
