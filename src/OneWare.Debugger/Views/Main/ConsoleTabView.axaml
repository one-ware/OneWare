<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:main="clr-namespace:OneWare.Debugger.ViewModels.Main"
             xmlns:models="clr-namespace:OneWare.Debugger.Models"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="200"
             x:Class="OneWare.Debugger.Views.Main.ConsoleTabView"
             x:DataType="main:ConsoleTabViewModel">

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Bottom" Classes="footer" Padding="4">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Classes="icon" Margin="4 0 0 0"
                        Command="{Binding SendCommandCommand}" ToolTip.Tip="Send (Enter)">
                    <PathIcon Data="{StaticResource Icon.Send}" />
                </Button>
                <TextBox Name="CommandBox" Classes="small" FontFamily="{DynamicResource EditorFont}"
                         Text="{Binding CommandText, Mode=TwoWay}"
                         Watermark="GDB command, e.g. info frame">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SendCommandCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
            </DockPanel>
        </Border>

        <!-- Every line is its own SelectableTextBlock, so that commands stay set apart
             by colour. Nothing can be selected across line boundaries that way, though -
             hence the copy button and the context menu that put the whole history on the clipboard. -->
        <Grid Background="Transparent">
            <Grid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy All" Click="OnCopyConsoleClick">
                        <MenuItem.Icon>
                            <PathIcon Data="{StaticResource Icon.Copy}" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </Grid.ContextMenu>

            <ScrollViewer Name="DebuggerConsoleScroll" Padding="8 6">
                <ItemsControl ItemsSource="{Binding Lines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ConsoleLine">
                            <SelectableTextBlock Classes="mono"
                                                 Classes.accent="{Binding IsCommand}"
                                                 Classes.semibold="{Binding IsCommand}"
                                                 TextWrapping="Wrap"
                                                 Text="{Binding Text}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Button Name="CopyConsoleButton" Classes="icon"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 4 14 0"
                    Click="OnCopyConsoleClick"
                    ToolTip.Tip="Copy the whole console to the clipboard">
                <PathIcon Data="{StaticResource Icon.Copy}" />
            </Button>
        </Grid>
    </DockPanel>
</UserControl>
