<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:main="clr-namespace:OneWare.Debugger.ViewModels.Main"
             xmlns:models="clr-namespace:OneWare.Debugger.Models"
             xmlns:views="clr-namespace:OneWare.Debugger.Views"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="200"
             x:Class="OneWare.Debugger.Views.Main.RegisterTabView"
             x:DataType="main:RegisterTabViewModel">

    <DockPanel LastChildFill="True">
        <Grid>
            <DataGrid ItemsSource="{Binding Rows}"
                      Background="{DynamicResource ThemeControlLowBrush}"
                      RowBackground="Transparent"
                      GridLinesVisibility="None"
                      BorderThickness="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserReorderColumns="False"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Register" Width="*" FontFamily="{DynamicResource EditorFont}"
                                        Binding="{CompiledBinding Name, DataType=models:RegisterRow}" />
                    <DataGridTemplateColumn Header="Value" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:RegisterRow">
                                <views:EditableValueCell FontFamily="{DynamicResource EditorFont}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Classes="empty-state" IsVisible="{Binding !Rows.Count}" IsHitTestVisible="False">
                <TextBlock TextWrapping="Wrap" Text="Registers appear here while the program is paused." />
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
