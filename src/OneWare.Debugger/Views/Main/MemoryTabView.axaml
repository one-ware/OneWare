<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:main="clr-namespace:OneWare.Debugger.ViewModels.Main"
             xmlns:models="clr-namespace:OneWare.Debugger.Models"
             xmlns:views="clr-namespace:OneWare.Debugger.Views"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="200"
             x:Class="OneWare.Debugger.Views.Main.MemoryTabView"
             x:DataType="main:MemoryTabViewModel">

    <!-- Same surface as the grid and no header bar: the address field sits on it like the
         search field of the project explorer. -->
    <DockPanel LastChildFill="True" Background="{DynamicResource ThemeControlLowBrush}">
        <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="4">
            <StackPanel DockPanel.Dock="Right" Classes="toolbar" Margin="4 0 0 0">
                <Button Classes="icon" Command="{Binding RemoveWatchCommand}"
                        ToolTip.Tip="Remove selected addresses (Del)">
                    <PathIcon Data="{StaticResource Icon.Remove}" />
                </Button>
                <Button Classes="icon" Command="{Binding ClearWatchesCommand}" ToolTip.Tip="Clear all watches">
                    <PathIcon Data="{StaticResource Icon.ClearAll}" />
                </Button>
            </StackPanel>

            <TextBox Name="AddressBox" Classes="search mono" FontFamily="{DynamicResource EditorFont}"
                     TextWrapping="NoWrap" AcceptsReturn="False"
                     Text="{Binding AddressText, Mode=TwoWay}"
                     Watermark="{Binding AddressWatermark}">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding AddWatchCommand}" />
                </TextBox.KeyBindings>
                <TextBox.InnerLeftContent>
                    <PathIcon Classes="small muted" Margin="4 0 6 0" VerticalAlignment="Center"
                              Data="{StaticResource Icon.Search}" />
                </TextBox.InnerLeftContent>
                <TextBox.InnerRightContent>
                    <Button Classes="icon small" VerticalAlignment="Center" Margin="0 0 2 0"
                            Command="{Binding AddWatchCommand}" ToolTip.Tip="Watch this address (Enter)"
                            IsVisible="{Binding #AddressBox.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <PathIcon Classes="small" Data="{StaticResource Icon.Eye}" />
                    </Button>
                </TextBox.InnerRightContent>
            </TextBox>
        </DockPanel>

        <Grid>
            <DataGrid x:Name="WatchGrid"
                      ItemsSource="{Binding Watches}"
                      SelectionMode="Extended"
                      SelectionChanged="OnSelectionChanged"
                      Background="Transparent"
                      RowBackground="Transparent"
                      GridLinesVisibility="None"
                      BorderThickness="0"
                      AutoGenerateColumns="False"
                      CanUserReorderColumns="False"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
                <DataGrid.KeyBindings>
                    <KeyBinding Gesture="Delete" Command="{Binding RemoveWatchCommand}" />
                </DataGrid.KeyBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Address" Width="*" IsReadOnly="True" FontFamily="{DynamicResource EditorFont}"
                                        Binding="{CompiledBinding Address, DataType=models:MemoryRow}" />
                    <DataGridTextColumn Header="Bytes" Width="*" IsReadOnly="True" FontFamily="{DynamicResource EditorFont}"
                                        Binding="{CompiledBinding Bytes, DataType=models:MemoryRow}" />
                    <DataGridTemplateColumn Header="Value" Width="*" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:MemoryRow">
                                <views:EditableValueCell FontFamily="{DynamicResource EditorFont}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Classes="empty-state" IsVisible="{Binding !Watches.Count}" IsHitTestVisible="False">
                <TextBlock TextWrapping="Wrap" Text="Enter an address or symbol above and press Enter to watch memory." />
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
