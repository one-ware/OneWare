<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:inspector="clr-namespace:OneWare.Debugger.ViewModels.Inspector"
             xmlns:models="clr-namespace:OneWare.Debugger.Models"
             xmlns:views="clr-namespace:OneWare.Debugger.Views"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="420"
             x:Class="OneWare.Debugger.Views.Inspector.VariablesView"
             x:DataType="inspector:VariablesViewModel">

    <DockPanel LastChildFill="True">
        <Grid>
            <DataGrid ItemsSource="{Binding Variables}"
                      Background="{DynamicResource ThemeControlLowBrush}"
                      RowBackground="Transparent"
                      GridLinesVisibility="None"
                      BorderThickness="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserReorderColumns="False"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Width="1.5*"
                                        Binding="{CompiledBinding Name, DataType=models:VariableRow}" />
                    <DataGridTemplateColumn Header="Value" Width="1.75*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="models:VariableRow">
                                <views:EditableValueCell FontFamily="{DynamicResource EditorFont}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Type" Width="0.75*" Foreground="{DynamicResource ThemeForegroundLowBrush}"
                                        Binding="{CompiledBinding Type, DataType=models:VariableRow}" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Classes="empty-state" IsVisible="{Binding !Variables.Count}" IsHitTestVisible="False">
                <TextBlock TextWrapping="Wrap" Text="Local variables appear here while the program is paused." />
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
