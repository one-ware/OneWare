<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:inspector="clr-namespace:OneWare.Debugger.ViewModels.Inspector"
             xmlns:editorExtensions="clr-namespace:OneWare.Essentials.EditorExtensions;assembly=OneWare.Essentials"
             xmlns:converters="clr-namespace:OneWare.Debugger.Helpers"
             xmlns:controls="clr-namespace:OneWare.Essentials.Controls;assembly=OneWare.Essentials"
             mc:Ignorable="d" d:DesignWidth="280" d:DesignHeight="420"
             x:Class="OneWare.Debugger.Views.Inspector.BreakpointsView"
             x:DataType="inspector:BreakpointsViewModel">

    <!-- Same layout as the Memory tab: a search field on the list's surface, no header bar. -->
    <DockPanel LastChildFill="True" Background="{DynamicResource ThemeControlLowBrush}">
        <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="4">
            <StackPanel DockPanel.Dock="Right" Classes="toolbar" Margin="4 0 0 0">
                <Button Classes="icon" Command="{Binding RemoveBreakpointCommand}"
                        ToolTip.Tip="Remove selected breakpoints (Del)">
                    <PathIcon Data="{StaticResource Icon.Remove}" />
                </Button>
                <Button Classes="icon" Command="{Binding RemoveAllBreakpointsCommand}"
                        ToolTip.Tip="Remove all listed breakpoints">
                    <PathIcon Data="{StaticResource Icon.ClearAll}" />
                </Button>
            </StackPanel>

            <controls:SearchBox SearchText="{Binding FilterText, Mode=TwoWay}" SearchButtonVisible="False"
                                Label="Filter by file or line..." />
        </DockPanel>

        <Grid>
            <DataGrid x:Name="BreakpointGrid"
                      ItemsSource="{Binding Breakpoints}"
                      SelectionMode="Extended"
                      SelectionChanged="OnSelectionChanged"
                      Background="Transparent"
                      RowBackground="Transparent"
                      GridLinesVisibility="None"
                      BorderThickness="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserReorderColumns="False"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
                <DataGrid.KeyBindings>
                    <KeyBinding Gesture="Delete" Command="{Binding RemoveBreakpointCommand}" />
                </DataGrid.KeyBindings>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="File" Width="*"
                                        Binding="{CompiledBinding File, DataType=editorExtensions:BreakPoint,
                                                  Converter={x:Static converters:ProjectRelativePathConverter.Instance}}" />
                    <DataGridTextColumn Header="Line" Width="Auto" FontFamily="{DynamicResource EditorFont}"
                                        Binding="{CompiledBinding Line, DataType=editorExtensions:BreakPoint}" />
                    <DataGridCheckBoxColumn Header="Verified" Width="Auto"
                                            Binding="{CompiledBinding IsVerified, DataType=editorExtensions:BreakPoint}" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Classes="empty-state" IsVisible="{Binding !HasBreakpoints}" IsHitTestVisible="False">
                <TextBlock TextWrapping="Wrap" Text="No breakpoints in the active project. Click left of a line number in the editor to add one." />
            </Border>
            <Border Classes="empty-state" IsVisible="{Binding HasNoMatches}" IsHitTestVisible="False">
                <TextBlock TextWrapping="Wrap" Text="No breakpoints match the filter." />
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
