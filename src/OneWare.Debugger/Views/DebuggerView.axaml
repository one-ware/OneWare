<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:OneWare.Debugger.ViewModels"
             xmlns:models="clr-namespace:OneWare.Debugger.Models"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="260"
             x:Class="OneWare.Debugger.Views.DebuggerView"
             x:DataType="viewModels:DebuggerViewModel"
             Background="{DynamicResource ThemeControlLowBrush}">

    <UserControl.Styles>
        <!-- Abgesetzte Kommandos heben sich von der Antwort des Backends ab. -->
        <Style Selector="SelectableTextBlock.consoleLine">
            <Setter Property="FontFamily" Value="{DynamicResource EditorFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Padding" Value="0,1" />
        </Style>
        <Style Selector="SelectableTextBlock.consoleLine.command">
            <Setter Property="Foreground" Value="{DynamicResource ThemeAccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <DockPanel LastChildFill="True">

        <Border DockPanel.Dock="Top"
                Background="{DynamicResource ThemeBackgroundBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}">
            <StackPanel Orientation="Horizontal" Spacing="2" Margin="4" VerticalAlignment="Center">
                <Button Width="24" Height="24" Command="{Binding StartCommand}" ToolTip.Tip="Start Debugging">
                    <Image Source="{DynamicResource Material.BugReport}" />
                </Button>
                <Button Width="24" Height="24" Command="{Binding PauseCommand}" ToolTip.Tip="Pause"
                        IsVisible="{Binding IsRunning}">
                    <Image Source="{DynamicResource VsCodeLight.Debug-Pause}" />
                </Button>
                <Button Width="24" Height="24" Command="{Binding ContinueCommand}" ToolTip.Tip="Continue"
                        IsVisible="{Binding !IsRunning}">
                    <Image Source="{DynamicResource MaterialDesign.PlayArrow}" />
                </Button>
                <Button Width="24" Height="24" Command="{Binding StopCommand}" ToolTip.Tip="Stop">
                    <Image Source="{DynamicResource VsCodeLight.Debug-Stop}" />
                </Button>

                <Border Classes="SplitterBorder" Margin="6,4" Width="1" />

                <Button Width="24" Height="24" Command="{Binding StepOverCommand}" ToolTip.Tip="Step Over">
                    <Image Source="{DynamicResource VsCodeLight.Debug-Step-Over}" />
                </Button>
                <Button Width="24" Height="24" Command="{Binding StepIntoCommand}" ToolTip.Tip="Step Into">
                    <Image Source="{DynamicResource VsCodeLight.Debug-Step-Into}" />
                </Button>
                <Button Width="24" Height="24" Command="{Binding StepOutCommand}" ToolTip.Tip="Step Out">
                    <Image Source="{DynamicResource VsCodeLight.Debug-Step-Out}" />
                </Button>

                <Border Classes="SplitterBorder" Margin="6,4" Width="1" />

                <TextBlock VerticalAlignment="Center" Opacity="0.7" Text="{Binding StatusText}" />
            </StackPanel>
        </Border>

        <!-- Eigene Zeile ueber dem TabControl, damit die getroffene Auswahl in jedem Reiter
             sichtbar bleibt und nicht mit dem Wechsel auf Registers oder Memory verschwindet.
             "Launch" statt "Executable", weil hier auch Vorbereiter stehen, die ihre
             Programmdatei erst erzeugen. -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource ThemeBackgroundBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}">
            <DockPanel Margin="4" LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Opacity="0.7"
                           Margin="0,0,6,0" Text="Launch" />
                <Button DockPanel.Dock="Right" Margin="4,0,0,0" Height="24" Padding="8,0"
                        Command="{Binding BrowseExecutableCommand}" Content="..."
                        ToolTip.Tip="Select an executable outside the project" />
                <ComboBox ItemsSource="{Binding Executables}"
                          SelectedItem="{Binding SelectedExecutable}"
                          PlaceholderText="Nothing to launch - debugging without symbols"
                          HorizontalAlignment="Stretch"
                          Height="24">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:ExecutableOption">
                            <TextBlock Text="{Binding Display}" ToolTip.Tip="{Binding Path}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </DockPanel>
        </Border>

        <TabControl Padding="0" Margin="0" SelectedIndex="{Binding SelectedTabIndex}">

            <TabItem Header="Registers">
                <Border Margin="4"
                        CornerRadius="4"
                        ClipToBounds="True"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                        Background="{DynamicResource ThemeBackgroundBrush}">
                    <DataGrid ItemsSource="{Binding Registers}"
                              GridLinesVisibility="Vertical"
                              VerticalGridLinesBrush="{DynamicResource ThemeBorderLowBrush}"
                              BorderThickness="0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Register" Width="*"
                                                Binding="{CompiledBinding Name, DataType=models:RegisterRow}" />
                            <DataGridTextColumn Header="Value" Width="*"
                                                Binding="{CompiledBinding Value, DataType=models:RegisterRow}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <TabItem Header="Memory">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource ThemeBackgroundBrush}"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource ThemeBorderLowBrush}">
                        <DockPanel Margin="4" LastChildFill="True">
                            <Button DockPanel.Dock="Right" Margin="4,0,0,0" Width="24" Height="24"
                                    Command="{Binding AddMemoryWatchCommand}"
                                    ToolTip.Tip="Watch this address">
                                <Image Width="14" Height="14"
                                       Source="{DynamicResource MaterialDesign.EyeTracking}" />
                            </Button>
                            <Button DockPanel.Dock="Right" Width="24" Height="24"
                                    Command="{Binding RemoveMemoryWatchCommand}" ToolTip.Tip="Remove address">
                                <Image Width="14" Height="14" Source="{DynamicResource Material.Remove}" />
                            </Button>
                            <TextBox Text="{Binding MemoryAddressText, Mode=TwoWay}"
                                     Watermark="Address, e.g. 0x2001ff80 or &amp;buffer"
                                     FontFamily="{DynamicResource EditorFont}"
                                     Background="{DynamicResource ThemeControlLowBrush}"
                                     BorderThickness="0"
                                     Height="24"
                                     Padding="6,2" />
                        </DockPanel>
                    </Border>

                    <Border Margin="4"
                            CornerRadius="4"
                            ClipToBounds="True"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                            Background="{DynamicResource ThemeBackgroundBrush}">
                        <DataGrid ItemsSource="{Binding MemoryWatches}"
                                  SelectedItem="{Binding SelectedMemoryRow}"
                                  GridLinesVisibility="Vertical"
                                  VerticalGridLinesBrush="{DynamicResource ThemeBorderLowBrush}"
                                  BorderThickness="0"
                                  AutoGenerateColumns="False"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Address" Width="Auto"
                                                    Binding="{CompiledBinding Address, DataType=models:MemoryRow}" />
                                <DataGridTextColumn Header="Bytes" Width="Auto"
                                                    Binding="{CompiledBinding Length, DataType=models:MemoryRow}" />
                                <DataGridTextColumn Header="Value" Width="*" IsReadOnly="True"
                                                    Binding="{CompiledBinding Value, DataType=models:MemoryRow}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>
            </TabItem>

            <TabItem Header="Debugger Console">
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Bottom"
                            BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource ThemeBorderLowBrush}">
                        <DockPanel Background="{DynamicResource ThemeBackgroundBrush}">
                            <Button DockPanel.Dock="Right" Margin="4" Height="26" Padding="8,0"
                                    Command="{Binding SendCommandCommand}" Content="Send" />
                            <TextBox Name="CommandBox"
                                     Text="{Binding CommandText, Mode=TwoWay}"
                                     Watermark="Command for the debug backend"
                                     FontFamily="{DynamicResource EditorFont}"
                                     Background="{DynamicResource ThemeControlLowBrush}"
                                     BorderThickness="0"
                                     Padding="6,2" />
                        </DockPanel>
                    </Border>

                    <Border Background="{DynamicResource ThemeBackgroundBrush}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ThemeBorderLowBrush}">
                        <ScrollViewer Name="DebuggerConsoleScroll" Padding="8,6">
                            <ItemsControl ItemsSource="{Binding DebuggerConsole}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ConsoleLine">
                                        <SelectableTextBlock Classes="consoleLine"
                                                             Classes.command="{Binding IsCommand}"
                                                             Text="{Binding Text}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</UserControl>
