<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:OneWare.Debugger.ViewModels"
             mc:Ignorable="d" d:DesignWidth="200" d:DesignHeight="24"
             x:Class="OneWare.Debugger.Views.ValueFormatBar"
             x:DataType="viewModels:ValueFormatViewModel">

    <!-- Sits in the header toolbar of Registers, Memory and Variables; all three share the view model. -->
    <StackPanel Classes="toolbar" IsEnabled="{Binding !IsLocked}">
        <TextBlock Classes="muted" Text="Base" />
        <ComboBox Classes="small" MinWidth="64"
                  ItemsSource="{Binding Bases}"
                  SelectedItem="{Binding SelectedBase, Mode=TwoWay}"
                  ToolTip.Tip="Number base for values (Dec is the only base where the sign matters)" />
    </StackPanel>
</UserControl>
