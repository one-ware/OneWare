<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:OneWare.Chat.ViewModels"
             xmlns:views="clr-namespace:OneWare.Chat.Views"
             xmlns:chatMessages="clr-namespace:OneWare.Chat.ViewModels.ChatMessages"
             xmlns:controls="clr-namespace:OneWare.Essentials.Controls;assembly=OneWare.Essentials"
             xmlns:behaviors="clr-namespace:OneWare.Chat.Behaviors"
             xmlns:behaviors1="clr-namespace:OneWare.Essentials.Behaviors;assembly=OneWare.Essentials"
             xmlns:models="clr-namespace:OneWare.Essentials.Models;assembly=OneWare.Essentials"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="OneWare.Chat.Views.ChatView" Name="ChatViewView"
             Background="{DynamicResource ThemeControlLowBrush}" x:DataType="viewModels:ChatViewModel">
    <Grid RowDefinitions="*, Auto, Auto" RowSpacing="4">
        <Panel>
            <!-- Overview: all chats, working ones first, then newest first -->
            <DockPanel IsVisible="{Binding IsOverviewVisible}">
                <Border DockPanel.Dock="Top" Classes="header" Padding="4">
                    <DockPanel>
                        <TextBlock Classes="semibold" Margin="4" Text="Chats" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <Panel>
                    <Border Classes="empty-state" IsVisible="{Binding !Overview.Count}">
                        <TextBlock Classes="muted" Text="No chats yet" />
                    </Border>

                    <ListBox Classes="transparent" ItemsSource="{Binding Overview}"
                             SelectedItem="{Binding SelectedOverviewItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="4">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:ChatOverviewItem">
                                <Grid ColumnDefinitions="16, *, Auto" RowDefinitions="Auto, Auto" ColumnSpacing="6">
                                    <Panel Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <controls:LogoLoader IsVisible="{Binding Session.IsBusy, FallbackValue=False}"
                                                             ToolTip.Tip="Working" />
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource ThemeAccentBrush}"
                                                 ToolTip.Tip="Finished or waiting for you">
                                            <Ellipse.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                    <Binding Path="Session.HasAttention" FallbackValue="False" />
                                                    <Binding Path="!Session.IsBusy" FallbackValue="False" />
                                                </MultiBinding>
                                            </Ellipse.IsVisible>
                                        </Ellipse>
                                    </Panel>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Classes="caption" Text="{Binding UpdatedAtLabel}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Classes="caption"
                                               Text="{Binding ServiceName}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Panel>
            </DockPanel>

            <!-- The shown chat -->
            <Grid RowDefinitions="Auto, *, Auto" RowSpacing="4"
                  IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}"
                  DataContext="{Binding CurrentSession}">
                <Border Background="{DynamicResource ThemeBackgroundBrush}"
                        BorderThickness="0 0 0 1" Padding="4">
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Classes="icon" VerticalAlignment="Center" ToolTip.Tip="All chats"
                                Command="{Binding #ChatViewView.((viewModels:ChatViewModel)DataContext).ShowOverviewCommand, FallbackValue={x:Null}}">
                            <PathIcon Classes="small" Data="{StaticResource Icon.ArrowLeft}" />
                        </Button>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button
                                Command="{Binding #ChatViewView.((viewModels:ChatViewModel)DataContext).NewChatCommand, FallbackValue={x:Null}}"
                                IsVisible="{Binding !IsBlocked}">
                                <PathIcon Classes="small" Data="{StaticResource Icon.Add}" />
                            </Button>

                            <ContentControl VerticalAlignment="Center"
                                            Content="{Binding Service.HeaderUiExtension, FallbackValue={x:Null}}" />
                        </StackPanel>

                        <TextBlock Margin="4 0" VerticalAlignment="Center" Classes="semibold" Text="{Binding Title}"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>

                <Panel Grid.Row="1">
                    <DockPanel IsVisible="{Binding !IsBlocked}">
                        <!-- Loading indicator + queued messages are pinned below the conversation and kept
                             outside the scrolling region so the virtualizing message list above can virtualize
                             against the viewport (it must be the direct content of the ScrollViewer). -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="10 6 0 0" Spacing="5">
                            <!-- Activity indicator: agent working, or a send waiting for the service to connect -->
                            <Grid ColumnDefinitions="Auto, Auto" ColumnSpacing="6"
                                  IsVisible="{Binding IsActivityVisible}">
                                <controls:LogoLoader VerticalAlignment="Center" />

                                <controls:ShimmerTextBlock Grid.Column="1"
                                                           Foreground="{DynamicResource ThemeForegroundBrush}"
                                                           FontSize="11" FontStyle="Italic"
                                                           Text="{Binding WorkingStatusText}" />
                            </Grid>

                            <!-- Connection problem: the service's status as the reason, with a retry -->
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0 0 10 0"
                                        IsVisible="{Binding HasConnectionProblem}">
                                <PathIcon Classes="small warning" VerticalAlignment="Center"
                                          Data="{StaticResource Icon.Warning}" />
                                <TextBlock Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap"
                                           Text="{Binding StatusText}" />
                                <Button Classes="link" VerticalAlignment="Center" Content="Retry"
                                        Command="{Binding InitializeCurrentCommand}" />
                            </StackPanel>

                            <!-- Queued messages (dimmed, pinned below the conversation) -->
                            <ItemsControl Opacity="0.5" ItemsSource="{Binding QueuedMessages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="chatMessages:ChatMessageUserViewModel">
                                        <Border Margin="0 2" HorizontalAlignment="Right" CornerRadius="6"
                                                Padding="8 4 4 4" Background="{DynamicResource ChatBubbleBrush}">
                                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="6">
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="13"
                                                           VerticalAlignment="Center" />
                                                <Button Grid.Column="1"
                                                        Command="{Binding #ChatViewView.((viewModels:ChatViewModel)DataContext).CurrentSession.RemoveQueuedMessageCommand, FallbackValue={x:Null}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip.Tip="Remove queued message">
                                                    <Image Source="{DynamicResource MaterialDesign.Close}" Width="12"
                                                           Height="12" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="5" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>

                        <ScrollViewer Name="ScrollViewer" HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <Interaction.Behaviors>
                                <AutoScrollDuringDragBehavior ScrollDelta="4" />
                            </Interaction.Behaviors>

                            <ItemsControl Name="ItemsControl" ItemsSource="{Binding Messages}" Margin="10 0">
                                <ItemsControl.ContextFlyout>
                                    <MenuFlyout Opening="OnMessagesContextFlyoutOpening">
                                        <MenuItem Header="Copy" InputGesture="Ctrl+C" Click="OnCopySelectionClick">
                                            <MenuItem.Icon>
                                                <Image Source="{DynamicResource BoxIcons.RegularCopy}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </MenuFlyout>
                                </ItemsControl.ContextFlyout>
                                <ItemsControl.Styles>
                                    <Style Selector="Expander /template/ ToggleButton">
                                        <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush4}" />
                                        <Setter Property="CornerRadius" Value="3" />
                                    </Style>
                                    <Style Selector="Expander /template/ ToggleButton:pointerover /template/ Border">
                                        <Setter Property="Background" Value="{DynamicResource ThemeAccentBrush4}" />
                                    </Style>
                                    <Style
                                        Selector="Expander /template/ ToggleButton:pointerover /template/ Border Border">
                                        <Setter Property="Background" Value="Transparent" />
                                    </Style>
                                    <Style Selector="Expander /template/ ToggleButton#PART_toggle /template/ Border">
                                        <Setter Property="CornerRadius" Value="3" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                    <Style
                                        Selector="Expander /template/ ToggleButton#PART_toggle /template/ Grid > Border">
                                        <Setter Property="Margin" Value="0 2" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </ItemsControl.Styles>

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <controls:EstimatingVirtualizingStackPanel Spacing="7" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>

                    <!-- Replaces the chat while the selected service cannot be used (login, subscription, ...) -->
                    <views:ChatBlockerView IsVisible="{Binding IsBlocked}" Margin="20" />

                    <!--
                    <Border VerticalAlignment="Center" HorizontalAlignment="Center"
                            IsVisible="{Binding NeedsAuthentication}">
                        <Button Command="{Binding AuthenticateCommand}" 
                                Background="{DynamicResource ThemeBackgroundBrush}"
                                Padding="5" Classes="RoundButton" Height="30">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock>
                                    <Run Text="Login to " />
                                    <Run Text="{Binding Service.Name, FallbackValue={x:Null}}" />
                                </TextBlock>
                            </StackPanel>
                        </Button>
                    </Border>
                    -->
                </Panel>

                <Border Grid.Row="2" Margin="10 0" Background="{DynamicResource ChatBubbleBrush}"
                        Classes="RoundBorder"
                        DataContext="{Binding #ChatViewView.DataContext}" x:DataType="viewModels:ChatViewModel">
                    <Border.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="!!AiFileEditService.ActiveEdits.Count" />
                            <Binding Path="!CurrentSession.IsBlocked" FallbackValue="False" />
                        </MultiBinding>
                    </Border.IsVisible>
                    <StackPanel Orientation="Vertical" Spacing="5">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <TextBlock Margin="4 0" VerticalAlignment="Center" Text="Changed Files"
                                       Foreground="{DynamicResource ThemeForegroundLowBrush}" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                                <Button Command="{Binding AiFileEditService.UndoAllAsync}"
                                        ToolTip.Tip="Discard all file changes">
                                    <TextBlock Text="Rollback" Foreground="{DynamicResource HighlightBrush}" />
                                </Button>
                                <Button Command="{Binding AiFileEditService.AcceptAllAsync}"
                                        ToolTip.Tip="Accept all file changes">
                                    <TextBlock Text="Accept All" Foreground="{DynamicResource HighlightBrush}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" MaxHeight="100">
                            <ItemsControl ItemsSource="{Binding AiFileEditService.ActiveEdits}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button
                                            Command="{Binding #ChatViewView.((viewModels:ChatViewModel)DataContext).ShowEditCommand, FallbackValue={x:Null}}"
                                            CommandParameter="{Binding }" HorizontalContentAlignment="Stretch"
                                            HorizontalAlignment="Stretch" Background="Transparent">
                                            <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="5">
                                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding AddedLines}" Foreground="Lime" />
                                                <TextBlock Grid.Column="2" Text="{Binding RemovedLines}"
                                                           Foreground="OrangeRed" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>
        </Panel>

        <!-- On the overview, a service that can't be used yet (login, subscription, ...) replaces the input box -->
        <Border Grid.Row="1" Margin="10 0" Classes="card" DataContext="{Binding ComposerSession}"
                x:DataType="viewModels:ChatSessionViewModel">
            <Border.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="IsBlocked" />
                    <Binding Path="#ChatViewView.((viewModels:ChatViewModel)DataContext).IsOverviewVisible"
                             FallbackValue="False" />
                </MultiBinding>
            </Border.IsVisible>
            <views:ChatBlockerView Margin="10" />
        </Border>

        <Border Grid.Row="1" DataContext="{Binding ComposerSession}"
                Margin="10 0" Background="{DynamicResource EditorInputSurfaceBrush}"
                Classes="RoundBorder" BorderThickness="1"
                IsVisible="{Binding !IsBlocked}"
                Classes.busy="{Binding IsBusy}">
            <Border.Styles>
                <Style Selector="Border.busy">
                    <Style.Animations>
                        <Animation Duration="0:0:1.6" IterationCount="INFINITE" PlaybackDirection="Alternate">
                            <KeyFrame Cue="0%">
                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderMidBrush}" />
                            </KeyFrame>
                            <KeyFrame Cue="100%">
                                <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                            </KeyFrame>
                        </Animation>
                    </Style.Animations>
                </Style>
            </Border.Styles>
            <Grid RowDefinitions="Auto, Auto, Auto, Auto">
                <ContentControl Grid.Row="0"
                                Content="{Binding Service.TopUiExtension, FallbackValue={x:Null}}" />

                <TextBox Grid.Row="1" Name="CommandBox" Watermark="Type your task here..."
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50" MaxHeight="240"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Padding="10 10 10 8" BorderThickness="0" Background="Transparent"
                         VerticalContentAlignment="Top" CaretBlinkInterval="00:00:00.5"
                         Text="{Binding CurrentMessage, Mode=TwoWay}" />

                <Border Grid.Row="2" Background="{DynamicResource EditorInputFooterBrush}"
                        BorderThickness="0 1 0 0"
                        CornerRadius="0 0 3 3" Padding="6 4">
                    <DockPanel Height="22" LastChildFill="False" VerticalAlignment="Bottom">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Command="{Binding AbortCommand}" IsVisible="{Binding IsBusy}">
                                <Image Source="{DynamicResource VSImageLib2019.Stop_16x}" Height="16" />
                            </Button>
                            <Button Command="{Binding SendCommand}">
                                <Image Source="{DynamicResource FluentIcons.send_regular}" Height="16" />
                            </Button>
                            <Button Name="SendModeButton" VerticalAlignment="Center" IsEnabled="{Binding IsBusy}"
                                    ToolTip.Tip="Message delivery">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuItem ToolTip.Tip="Stop and Send" Header="Send"
                                                  InputGesture="Alt+Enter"
                                                  Command="{Binding SendCommand}">
                                            <MenuItem.Icon>
                                                <Image Source="{DynamicResource FluentIcons.send_regular}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem ToolTip.Tip="Add to Queue" Header="Add to Queue"
                                                  Command="{Binding QueueCommand}">
                                            <MenuItem.Icon>
                                                <Image Source="{DynamicResource BoxIcons.RegularPlus}" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem ToolTip.Tip="Steer" Header="Steer with Message"
                                                  InputGesture="Enter"
                                                  Command="{Binding SteerCommand}" />
                                    </MenuFlyout>
                                </Button.Flyout>
                                <Image Source="{DynamicResource MaterialDesign.KeyboardArrowDown}" Width="8"
                                       Height="8" />
                            </Button>
                        </StackPanel>

                        <ContentControl DockPanel.Dock="Left"
                                        Content="{Binding Service.BottomUiExtension, FallbackValue={x:Null}}" />

                    </DockPanel>
                </Border>
            </Grid>

        </Border>

        <!-- Footer row: chat service selection (left) + service-specific extension (right) -->
        <Border Grid.Row="2" DataContext="{Binding ComposerSession}"
                BorderBrush="{DynamicResource ThemeBorderLowBrush}" Margin="10 0 10 4">
            <DockPanel LastChildFill="False" VerticalAlignment="Center">
                <Button Name="MenuButton" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button.Flyout>
                        <Flyout FlyoutPresenterClasses="flush"
                                Placement="Top">
                            <ListBox
                                ItemsSource="{Binding #ChatViewView.((viewModels:ChatViewModel)DataContext).ChatServices}"
                                SelectedItem="{Binding #ChatViewView.((viewModels:ChatViewModel)DataContext).SelectedChatService}"
                                BorderThickness="0"
                                MinWidth="200">
                                <Interaction.Behaviors>
                                    <behaviors1:PointerPressedHandledEventTrigger RoutingStrategies="Bubble">
                                        <HideFlyoutAction Flyout="{Binding #MenuButton.Flyout}" />
                                    </behaviors1:PointerPressedHandledEventTrigger>
                                </Interaction.Behaviors>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="5">
                                            <TextBlock Text="{Binding Name}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ListBox>
                        </Flyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{Binding Service.Name, FallbackValue=Select Service}"
                                   FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ThemeForegroundLowBrush}" />
                        <Image Source="{DynamicResource MaterialDesign.KeyboardArrowDown}" Width="8"
                               Height="8" />
                    </StackPanel>
                </Button>

                <!-- Agent selector: Agent / Plan / Ask and custom agents -->
                <Button Name="AgentMenuButton" DockPanel.Dock="Left" VerticalAlignment="Center"
                        IsVisible="{Binding !IsBlocked}"
                        ToolTip.Tip="{Binding AgentService.SelectedAgent.Description}">
                    <Button.Flyout>
                        <Flyout FlyoutPresenterClasses="flush"
                                Placement="Top">
                            <ListBox ItemsSource="{Binding AgentService.Agents}"
                                     SelectedItem="{Binding AgentService.SelectedAgent}" BorderThickness="0"
                                     MinWidth="200" MaxHeight="320">
                                <Interaction.Behaviors>
                                    <behaviors1:PointerPressedHandledEventTrigger RoutingStrategies="Bubble">
                                        <HideFlyoutAction Flyout="{Binding #AgentMenuButton.Flyout}" />
                                    </behaviors1:PointerPressedHandledEventTrigger>
                                </Interaction.Behaviors>
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ChatAgentDefinition">
                                        <StackPanel Spacing="1" MaxWidth="260"
                                                    ToolTip.Tip="{Binding Description}">
                                            <TextBlock Text="{Binding DisplayName}" />
                                            <TextBlock Text="{Binding Description}" FontSize="10"
                                                       TextTrimming="CharacterEllipsis"
                                                       IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}"
                                                       Foreground="{DynamicResource ThemeForegroundLowBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ListBox>
                        </Flyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{Binding AgentService.SelectedAgent.DisplayName, FallbackValue=Agent}"
                                   FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource ThemeForegroundLowBrush}" />
                        <Image Source="{DynamicResource MaterialDesign.KeyboardArrowDown}" Width="8"
                               Height="8" />
                    </StackPanel>
                </Button>

                <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center"
                                IsVisible="{Binding !IsBlocked}"
                                Content="{Binding Service.FooterUiExtension, FallbackValue={x:Null}}" />
            </DockPanel>
        </Border>

    </Grid>
</UserControl>