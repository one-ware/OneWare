<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:idc="using:Dock.Avalonia.Controls"
        xmlns:core="using:Dock.Model.Core"
        xmlns:viewModels="clr-namespace:OneWare.Essentials.ViewModels;assembly=OneWare.Essentials"
        xmlns:controls="clr-namespace:OneWare.Essentials.Controls;assembly=OneWare.Essentials"
        xmlns:system="clr-namespace:System;assembly=System.Runtime"
        xmlns:controls1="clr-namespace:Dock.Model.Controls;assembly=Dock.Model"
        xmlns:converters="clr-namespace:OneWare.Essentials.Converters;assembly=OneWare.Essentials"
        xmlns:commands="clr-namespace:OneWare.Essentials.Commands;assembly=OneWare.Essentials"
        xmlns:dockConverters="using:Dock.Avalonia.Converters">

    <Styles.Resources>

        <!--Fixes for simple theme, can be removed once Dock #1026 is merges-->
        <system:Double x:Key="ScrollBarButtonArrowIconFontSize">10</system:Double>
        <SolidColorBrush x:Key="ScrollBarButtonArrowForeground" Color="{DynamicResource ThemeForegroundColor}" />
        <SolidColorBrush x:Key="ScrollBarButtonArrowForegroundPointerOver" Color="{DynamicResource ThemeAccentColor}" />
        
        <SolidColorBrush x:Key="DockApplicationAccentBrushLow" Color="{DynamicResource ThemeAccentColor}" />
        <SolidColorBrush x:Key="DockApplicationAccentBrushMed" Opacity="0.8" Color="{DynamicResource ThemeAccentColor}" />
        <SolidColorBrush x:Key="DockApplicationAccentBrushHigh" Opacity="0.6"
                         Color="{DynamicResource ThemeAccentColor}" />
        <SolidColorBrush x:Key="DockApplicationAccentForegroundBrush"
                         Color="{DynamicResource ThemeForegroundColor}" />
        <SolidColorBrush x:Key="DockApplicationAccentBrushIndicator" Color="{DynamicResource ThemeAccentColor}" />
        <SolidColorBrush x:Key="DockTabActiveBackgroundBrush" Color="{DynamicResource ThemeAccentColor}" />
        <SolidColorBrush x:Key="DockTabActiveForegroundBrush" Color="{DynamicResource HighlightForegroundColor}" />
        <SolidColorBrush x:Key="DockTabHoverBackgroundBrush" Color="{DynamicResource ThemeAccentColor}" />
        <SolidColorBrush x:Key="DockTabHoverForegroundBrush" Color="{DynamicResource ThemeForegroundColor}" />
        <SolidColorBrush x:Key="DockTabActiveIndicatorBrush" Color="{DynamicResource ThemeAccentColor}" />
        <system:Double x:Key="DockDocumentTabItemSeparatorOpacity">0</system:Double>

        <!-- The rounded dock card draws the outline, see Border.dock-card below -->
        <Thickness x:Key="DockDocumentContentBorderThickness">0</Thickness>
        <CornerRadius x:Key="DockDocumentTabItemCornerRadius">4 4 0 0</CornerRadius>
        <!-- ThemeCornerRadiusLarge on the bottom only, the top edge is the tab separator -->
        <CornerRadius x:Key="DockDocumentCardCornerRadius">0 0 6 6</CornerRadius>
        

        <ContextMenu x:Key="DocumentTabStripItemContextMenu" x:DataType="core:IDockable">
            <MenuItem Header="Copy Path"
                      Command="{x:Static commands:DocumentCommands.CopyPath}"
                      CommandParameter="{Binding}"
                      IsVisible="{Binding $parent[ContextMenu].((viewModels:ExtendedDocument)DataContext).FullPath,
                                          Converter={x:Static ObjectConverters.IsNotNull},
                                          FallbackValue={x:False}}" />
            <Separator IsVisible="{Binding $parent[ContextMenu].((viewModels:ExtendedDocument)DataContext).FullPath,
                                          Converter={x:Static ObjectConverters.IsNotNull},
                                          FallbackValue={x:False}}" />
            <MenuItem Header="{DynamicResource DocumentTabStripItemFloatString}"
                      Command="{Binding Owner.Factory.FloatDockable}"
                      CommandParameter="{Binding}">
                <MenuItem.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="CanFloat" />
                        <MultiBinding Converter="{x:Static CanRemoveDockableConverter.Instance}">
                            <Binding Path="((core:IDock)Owner).CanCloseLastDockable" FallbackValue="{x:True}" />
                            <Binding Path="((core:IDock)Owner).VisibleDockables.Count" FallbackValue="0" />
                        </MultiBinding>
                    </MultiBinding>
                </MenuItem.IsVisible>
            </MenuItem>
            <MenuItem Header="{DynamicResource DocumentTabStripItemFloatAllString}"
                      Command="{Binding Owner.Factory.FloatAllDockables}"
                      CommandParameter="{Binding}">
                <MenuItem.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="CanFloat" />
                        <MultiBinding Converter="{x:Static CanRemoveDockableConverter.Instance}">
                            <Binding Path="((core:IDock)Owner).CanCloseLastDockable" FallbackValue="{x:True}" />
                            <Binding Path="((core:IDock)Owner).VisibleDockables.Count" FallbackValue="0" />
                        </MultiBinding>
                    </MultiBinding>
                </MenuItem.IsVisible>
            </MenuItem>
            <Separator>
                <Separator.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="CanFloat" />
                        <MultiBinding Converter="{x:Static CanRemoveDockableConverter.Instance}">
                            <Binding Path="((core:IDock)Owner).CanCloseLastDockable" FallbackValue="{x:True}" />
                            <Binding Path="((core:IDock)Owner).VisibleDockables.Count" FallbackValue="0" />
                        </MultiBinding>
                    </MultiBinding>
                </Separator.IsVisible>
            </Separator>
            <MenuItem Header="{DynamicResource DocumentTabStripItemCloseString}"
                      Command="{Binding Owner.Factory.CloseDockable}"
                      CommandParameter="{Binding}">
                <MenuItem.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="CanClose" />
                        <MultiBinding Converter="{x:Static CanRemoveDockableConverter.Instance}">
                            <Binding Path="((core:IDock)Owner).CanCloseLastDockable" FallbackValue="{x:True}" />
                            <Binding Path="((core:IDock)Owner).VisibleDockables.Count" FallbackValue="0" />
                        </MultiBinding>
                    </MultiBinding>
                </MenuItem.IsVisible>
            </MenuItem>
            <MenuItem Header="{DynamicResource DocumentTabStripItemCloseOtherTabsString}"
                      Command="{Binding Owner.Factory.CloseOtherDockables}"
                      CommandParameter="{Binding}">
                <MenuItem.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="CanClose" />
                        <MultiBinding Converter="{x:Static CanRemoveDockableConverter.Instance}">
                            <Binding Path="((core:IDock)Owner).CanCloseLastDockable" FallbackValue="{x:True}" />
                            <Binding Path="((core:IDock)Owner).VisibleDockables.Count" FallbackValue="0" />
                        </MultiBinding>
                    </MultiBinding>
                </MenuItem.IsVisible>
            </MenuItem>
            <MenuItem Header="{DynamicResource DocumentTabStripItemCloseAllTabsString}"
                      Command="{Binding Owner.Factory.CloseAllDockables}"
                      CommandParameter="{Binding}">
                <MenuItem.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="CanClose" />
                        <MultiBinding Converter="{x:Static CanRemoveDockableConverter.Instance}">
                            <Binding Path="((core:IDock)Owner).CanCloseLastDockable" FallbackValue="{x:True}" />
                            <Binding Path="((core:IDock)Owner).VisibleDockables.Count" FallbackValue="0" />
                        </MultiBinding>
                    </MultiBinding>
                </MenuItem.IsVisible>
            </MenuItem>
            <MenuItem Header="{DynamicResource DocumentTabStripItemCloseTabsLeftString}"
                      Command="{Binding Owner.Factory.CloseLeftDockables}"
                      CommandParameter="{Binding}">
                <MenuItem.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="CanClose" />
                        <MultiBinding Converter="{x:Static CanRemoveDockableConverter.Instance}">
                            <Binding Path="((core:IDock)Owner).CanCloseLastDockable" FallbackValue="{x:True}" />
                            <Binding Path="((core:IDock)Owner).VisibleDockables.Count" FallbackValue="0" />
                        </MultiBinding>
                        <Binding Path="$parent[DocumentControl].TabsLayout"
                                 Converter="{x:Static DocumentTabLayoutMatchConverter.Instance}"
                                 ConverterParameter="Top" />
                    </MultiBinding>
                </MenuItem.IsVisible>
            </MenuItem>
            <MenuItem Header="{DynamicResource DocumentTabStripItemCloseTabsAboveString}"
                      Command="{Binding Owner.Factory.CloseLeftDockables}"
                      CommandParameter="{Binding}">
                <MenuItem.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="CanClose" />
                        <MultiBinding Converter="{x:Static CanRemoveDockableConverter.Instance}">
                            <Binding Path="((core:IDock)Owner).CanCloseLastDockable" FallbackValue="{x:True}" />
                            <Binding Path="((core:IDock)Owner).VisibleDockables.Count" FallbackValue="0" />
                        </MultiBinding>
                        <Binding Path="$parent[DocumentControl].TabsLayout"
                                 Converter="{x:Static DocumentTabLayoutMatchConverter.Instance}"
                                 ConverterParameter="Left,Right" />
                    </MultiBinding>
                </MenuItem.IsVisible>
            </MenuItem>
            <MenuItem Header="{DynamicResource DocumentTabStripItemCloseTabsRightString}"
                      Command="{Binding Owner.Factory.CloseRightDockables}"
                      CommandParameter="{Binding}">
                <MenuItem.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="CanClose" />
                        <MultiBinding Converter="{x:Static CanRemoveDockableConverter.Instance}">
                            <Binding Path="((core:IDock)Owner).CanCloseLastDockable" FallbackValue="{x:True}" />
                            <Binding Path="((core:IDock)Owner).VisibleDockables.Count" FallbackValue="0" />
                        </MultiBinding>
                        <Binding Path="$parent[DocumentControl].TabsLayout"
                                 Converter="{x:Static DocumentTabLayoutMatchConverter.Instance}"
                                 ConverterParameter="Top" />
                    </MultiBinding>
                </MenuItem.IsVisible>
            </MenuItem>
            <MenuItem Header="{DynamicResource DocumentTabStripItemCloseTabsBelowString}"
                      Command="{Binding Owner.Factory.CloseRightDockables}"
                      CommandParameter="{Binding}">
                <MenuItem.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="CanClose" />
                        <MultiBinding Converter="{x:Static CanRemoveDockableConverter.Instance}">
                            <Binding Path="((core:IDock)Owner).CanCloseLastDockable" FallbackValue="{x:True}" />
                            <Binding Path="((core:IDock)Owner).VisibleDockables.Count" FallbackValue="0" />
                        </MultiBinding>
                        <Binding Path="$parent[DocumentControl].TabsLayout"
                                 Converter="{x:Static DocumentTabLayoutMatchConverter.Instance}"
                                 ConverterParameter="Left,Right" />
                    </MultiBinding>
                </MenuItem.IsVisible>
            </MenuItem>
            <Separator>
                <Separator.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="CanClose" />
                        <MultiBinding Converter="{x:Static CanRemoveDockableConverter.Instance}">
                            <Binding Path="((core:IDock)Owner).CanCloseLastDockable" FallbackValue="{x:True}" />
                            <Binding Path="((core:IDock)Owner).VisibleDockables.Count" FallbackValue="0" />
                        </MultiBinding>
                    </MultiBinding>
                </Separator.IsVisible>
            </Separator>
            <MenuItem Header="{DynamicResource DocumentTabStripItemNewHorizontalDockString}"
                      Command="{Binding Owner.Factory.NewHorizontalDocumentDock}"
                      CommandParameter="{Binding}">
                <MenuItem.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="CanDrag" />
                        <Binding Path="CanDrop" />
                    </MultiBinding>
                </MenuItem.IsVisible>
            </MenuItem>
            <MenuItem Header="{DynamicResource DocumentTabStripItemNewVerticalDockString}"
                      Command="{Binding Owner.Factory.NewVerticalDocumentDock}"
                      CommandParameter="{Binding}">
                <MenuItem.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="CanDrag" />
                        <Binding Path="CanDrop" />
                    </MultiBinding>
                </MenuItem.IsVisible>
            </MenuItem>
        </ContextMenu>
    </Styles.Resources>

    <Design.PreviewWith>
        <idc:DocumentControl Width="300" Height="400" />
    </Design.PreviewWith>

    <!--
        Every tool / document dock is a rounded card. The transparent 4px splitters between docks become the gaps.
        The Tool/DocumentDockControl templates match Dock's own, with the content wrapped in the card.
        The content is clipped to the rounded shape and the outline is a separate border drawn on top, otherwise
        content (active headers, colored views) paints over the border at the corners.
    -->
    <Style Selector="Border.dock-card">
        <Setter Property="Background" Value="{DynamicResource ThemeBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ThemeCornerRadiusLarge}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Border.dock-card-outline">
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderLowBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource ThemeBorderThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ThemeCornerRadiusLarge}" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <Style Selector="ToolDockControl">
        <Setter Property="Template">
            <ControlTemplate x:DataType="controls1:IToolDock">
                <DockableControl Name="PART_DockableControl"
                                 TrackingMode="Visible"
                                 Background="{TemplateBinding Background}"
                                 DockProperties.IsDropArea="True"
                                 DockProperties.IsDockTarget="True">
                    <Panel IsVisible="{Binding !!VisibleDockables.Count}">
                        <Border Classes="dock-card">
                            <ToolChromeControl IsActive="{Binding IsActive}">
                                <ToolControl />
                            </ToolChromeControl>
                        </Border>
                        <Border Classes="dock-card-outline" />
                    </Panel>
                </DockableControl>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Documents: the tab row sits on the background, the card starts below the separator (which forms its top edge) -->
    <Style Selector="Border.dock-card.document, Border.dock-card-outline.document">
        <Setter Property="CornerRadius" Value="{DynamicResource DockDocumentCardCornerRadius}" />
    </Style>
    <Style Selector="Border.dock-card-outline.document">
        <Setter Property="BorderThickness" Value="1 0 1 1" />
    </Style>

    <Style Selector="DocumentDockControl">
        <Setter Property="Template">
            <ControlTemplate x:DataType="controls1:IDocumentDock">
                <DockableControl TrackingMode="Visible">
                    <Panel>
                        <DocumentControl IsActive="{Binding IsActive}"
                                         IsVisible="{Binding LayoutMode, Converter={x:Static dockConverters:DocumentLayoutModeMatchConverter.Instance}, ConverterParameter=Tabbed}" />
                        <Panel IsVisible="{Binding LayoutMode, Converter={x:Static dockConverters:DocumentLayoutModeMatchConverter.Instance}, ConverterParameter=Mdi}">
                            <Border Classes="dock-card">
                                <idc:MdiDocumentControl IsActive="{Binding IsActive}" />
                            </Border>
                            <Border Classes="dock-card-outline" />
                        </Panel>
                    </Panel>
                </DockableControl>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Matches Dock's DockDocumentControlSingleContentTemplate, with PART_Border wrapped in the document card -->
    <Style Selector="DocumentControl">
        <Setter Property="Template">
            <ControlTemplate x:DataType="controls1:IDocumentDock">
                <DockPanel x:Name="PART_DockPanel"
                           DockProperties.IsDropArea="True"
                           DockProperties.IsDockTarget="True"
                           DockProperties.ShowDockIndicatorOnly="{DynamicResource DockDocumentControlShowDockIndicatorOnly}"
                           DockProperties.IndicatorDockOperation="{DynamicResource DockDocumentControlIndicatorDockOperation}"
                           VerticalSpacing="{DynamicResource DockDocumentControlVerticalSpacing}"
                           Background="Transparent"
                           ZIndex="1">
                    <DocumentTabStrip x:Name="PART_TabStrip"
                                      ItemsSource="{Binding VisibleDockables}"
                                      SelectedItem="{Binding ActiveDockable, Mode=TwoWay}"
                                      CanCreateItem="{Binding CanCreateDocument}"
                                      IconTemplate="{TemplateBinding IconTemplate}"
                                      HeaderTemplate="{TemplateBinding HeaderTemplate}"
                                      ModifiedTemplate="{TemplateBinding ModifiedTemplate}"
                                      CloseTemplate="{TemplateBinding CloseTemplate}"
                                      CloseButtonTheme="{TemplateBinding CloseButtonTheme}"
                                      IsActive="{TemplateBinding IsActive}"
                                      Orientation="{Binding TabsLayout, Converter={x:Static DocumentTabOrientationConverter.Instance}}"
                                      DockPanel.Dock="{Binding TabsLayout, Converter={x:Static DocumentTabDockConverter.Instance}}"
                                      DockProperties.IsDropArea="True"
                                      DockProperties.DockAdornerHost="{Binding #PART_DockPanel}">
                        <DocumentTabStrip.Styles>
                            <Style Selector="DocumentTabStripItem">
                                <Setter Property="IsActive" Value="{Binding $parent[DocumentTabStrip].IsActive}" />
                            </Style>
                        </DocumentTabStrip.Styles>
                    </DocumentTabStrip>
                    <Panel x:Name="PART_DocumentSeperatorHost" IsVisible="{Binding #PART_TabStrip.IsVisible}">
                        <Panel x:Name="PART_DocumentSeperator"
                               IsVisible="{DynamicResource DockDocumentTabStripSeparatorVisible}" />
                    </Panel>
                    <Panel>
                        <Border x:Name="PART_Border" Classes="dock-card document">
                            <Grid>
                                <DockableControl DataContext="{Binding ActiveDockable}"
                                                 TrackingMode="Visible"
                                                 IsVisible="{Binding $parent[DocumentControl].HasVisibleDockables}">
                                    <DeferredContentControl x:Name="PART_ContentPresenter"
                                                            Content="{Binding}"
                                                            HorizontalAlignment="Stretch"
                                                            VerticalAlignment="Stretch">
                                        <DeferredContentControl.ContentTemplate>
                                            <ControlRecyclingDataTemplate Parent="{Binding #PART_ContentPresenter}" />
                                        </DeferredContentControl.ContentTemplate>
                                    </DeferredContentControl>
                                </DockableControl>

                                <ContentControl x:Name="PART_EmptyContentHost"
                                                Content="{Binding EmptyContent}"
                                                ContentTemplate="{Binding $parent[DocumentControl].EmptyContentTemplate}"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                IsVisible="{Binding !$parent[DocumentControl].HasVisibleDockables}" />
                            </Grid>
                        </Border>
                        <Border Classes="dock-card-outline document" />
                    </Panel>
                </DockPanel>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="ToolChromeControl /template/ Border#PART_Border">
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="ToolControl /template/ Border#PART_Border">
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Inset tool tabs so the selected one reads as a rounded pill (the presenter is hidden for single tools) -->
    <Style Selector="ToolTabStrip /template/ ItemsPresenter#PART_ItemsPresenter">
        <Setter Property="Margin" Value="3" />
    </Style>

    <!-- One continuous separator instead of Dock's "open under the selected tab" fills -->
    <Style Selector="ToolTabStrip /template/ Border#PART_BorderLeftFill, ToolTabStrip /template/ Border#PART_BorderRightFill">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ToolTabStrip:not(:singleitem) /template/ Border#PART_Border">
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeBorderLowBrush}" />
        <Setter Property="BorderThickness" Value="0 1 0 0" />
    </Style>

    <Style Selector="ToolTabStripItem /template/ Border">
        <Setter Property="CornerRadius" Value="{DynamicResource ThemeCornerRadius}" />
    </Style>

    <Style Selector="ToolControl">
        <Setter Property="HeaderTemplate">
            <DataTemplate DataType="core:IDockable">
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
            </DataTemplate>
        </Setter>
    </Style>

    <Style Selector="DocumentTabStripItem">
        <Setter Property="MinHeight" Value="25" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlTransparentBrush}" />
        <Setter Property="Padding" Value="4 1 4 0" />
    </Style>

    <Style Selector="DocumentControl /template/ Grid#PART_Grid">
        <Setter Property="Height" Value="0" />
    </Style>

    <Style Selector="ToolChromeControl /template/ Path#PART_ClosePath">
        <Setter Property="Fill" Value="{DynamicResource ThemeForegroundBrush}" />
    </Style>

    <Style Selector="ToolChromeControl /template/ Path#PART_PinPath">
        <Setter Property="Fill" Value="{DynamicResource ThemeForegroundBrush}" />
    </Style>

    <Style Selector="ToolTabStripItem">
        <Setter Property="Padding" Value="4 0" />
        <Setter Property="Height" Value="24" />
    </Style>
    <Style Selector="ToolTabStripItem:selected">
        <Setter Property="Background" Value="{DynamicResource ThemeControlHighlightMidBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource ThemeForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Margin" Value="0" />
        <!-- Must match the base padding, otherwise Dock's :selected padding shifts the text down -->
        <Setter Property="Padding" Value="4 0" />
    </Style>

    <Style Selector="TextBlock.LoadingFailed">
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
        <Setter Property="TextDecorations" Value="StrikeThrough" />
    </Style>

    <Style Selector="DocumentControl">
        <Setter Property="HeaderTemplate">
            <DataTemplate DataType="core:IDockable">
                <ContentControl Content="{Binding}">
                    <ContentControl.DataTemplates>
                        <DataTemplate DataType="viewModels:IExtendedDocument">
                            <StackPanel Name="HeaderContainer" Orientation="Horizontal" Margin="0 1"
                                        ToolTip.Tip="{Binding FullPath}">
                                <controls:Spinner IsVisible="{Binding IsLoading}" Height="12" Width="12"
                                                  VerticalAlignment="Center" HorizontalAlignment="Center" />

                                <controls:LayeredIconPresenter
                                    Height="17" Width="17"
                                    Value="{Binding Icon, FallbackValue={x:Null}}"
                                    VerticalAlignment="Center" IsVisible="{Binding !IsLoading}" />
                                <TextBlock Name="Title" MaxWidth="300" TextTrimming="CharacterEllipsis" 
                                           Margin="3 0 0 0" Classes.LoadingFailed="{Binding LoadingFailed}"
                                           Text="{Binding Title}" VerticalAlignment="Center" />
                                <TextBlock Text="*" IsVisible="{Binding IsDirty, FallbackValue=False}" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="core:IDockable">
                            <StackPanel Orientation="Horizontal" Margin="0 1">
                                <TextBlock MaxWidth="100" TextTrimming="CharacterEllipsis" Margin="3 0 0 0" Text="{Binding Title}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>
            </DataTemplate>
        </Setter>
    </Style>

    <Style Selector="DocumentTabStripItem:not(:active):selected">
        <Setter Property="Background" Value="{DynamicResource ThemeBorderLowBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource DockThemeForegroundBrush}" />
    </Style>

    <Style Selector="ToolControl">
        <Setter Property="HeaderTemplate">
            <DataTemplate DataType="viewModels:IExtendedTool">
                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Image VerticalAlignment="Center" Source="{Binding Icon}" Height="12" Width="12" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding Title}" />
                </StackPanel>
            </DataTemplate>
        </Setter>
    </Style>
    
    <Style Selector="PinnedDockControl > Grid > GridSplitter">
        <Setter Property="Width" Value="5" />
    </Style>
    
</Styles>