<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:ClassModifier="internal">

    <!-- Design tokens (colors, radii, spacing, font sizes) live in OneWare.Essentials/Styles/Tokens.axaml
         and are provided through OneWareTheme.axaml -->

    <FontFamily x:Key="Noto Sans">avares://OneWare.Core/Assets/Fonts#Noto Sans</FontFamily>
    <FontFamily x:Key="IntelOne Mono">avares://OneWare.Core/Assets/Fonts#IntelOne Mono</FontFamily>
    <FontFamily x:Key="Fira Code">avares://OneWare.Core/Assets/Fonts#Fira Code</FontFamily>
    <FontFamily x:Key="JetBrains Mono NL">avares://OneWare.Core/Assets/Fonts#JetBrains Mono NL</FontFamily>

    <FontFamily x:Key="EditorFont">avares://OneWare.Core/Assets/Fonts#JetBrains Mono NL</FontFamily>
    <FontFamily x:Key="ContentControlThemeFontFamily">avares://OneWare.Core/Assets/Fonts#Noto Sans</FontFamily>

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Dark">
            <DrawingBrush x:Key="CheckerBoardBrush16" TileMode="Tile" DestinationRect="0 0 16 16" Opacity="0.2">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Geometry="M0,1 L2,1 2,2, 1,2 1,0 0,0Z"
                                         Brush="{DynamicResource ThemeBorderLowColor}" />
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>

            <ResourceDictionary.MergedDictionaries>
                <MergeResourceInclude Source="avares://OneWare.Core/Styles/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <DrawingBrush x:Key="CheckerBoardBrush16" TileMode="Tile" DestinationRect="0 0 16 16" Opacity="0.2">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Geometry="M0,1 L2,1 2,2, 1,2 1,0 0,0Z"
                                         Brush="{DynamicResource ThemeBorderLowColor}" />
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>

            <ResourceDictionary.MergedDictionaries>
                <MergeResourceInclude Source="avares://OneWare.Core/Styles/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
