<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:windows="clr-namespace:OneWare.Core.ViewModels.Windows"
             xmlns:controls="clr-namespace:OneWare.Essentials.Controls;assembly=OneWare.Essentials"
             xmlns:converters="clr-namespace:OneWare.Essentials.Converters;assembly=OneWare.Essentials"
             xmlns:enums="clr-namespace:OneWare.Essentials.Enums;assembly=OneWare.Essentials"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="OneWare.Core.Views.Windows.MainDock" x:DataType="windows:MainWindowViewModel">
    <UserControl.Styles>
        <!-- Top-right title bar icons are 2px larger than regular toolbar icons.
             Buttons: direct children and toolbar buttons of extension views only (not flyout content). -->
        <Style Selector="StackPanel#RightButtons > Button.icon, StackPanel#RightButtons :is(UserControl) > StackPanel.toolbar > Button.icon">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
        </Style>
        <Style Selector="StackPanel#RightButtons Button.icon PathIcon:not(Popup PathIcon)">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
        </Style>
    </UserControl.Styles>

    <Grid Background="{DynamicResource ThemeBackgroundBrush}" RowDefinitions="Auto,*" ColumnDefinitions="*">

        <!--Icon Tray-->
        <DockPanel Margin="4 4" Grid.Row="0" Name="IconTray" LastChildFill="False">

            <StackPanel DockPanel.Dock="Left" Classes="toolbar" Height="28" VerticalAlignment="Center">

                <Button Classes="icon" ToolTip.Tip="Undo" x:CompileBindings="False"
                        Command="{Binding DockService.CurrentDocument.Undo}">
                    <PathIcon Data="{StaticResource Icon.Undo}" />
                </Button>
                <Button Classes="icon" ToolTip.Tip="Redo" x:CompileBindings="False"
                        Command="{Binding DockService.CurrentDocument.Redo}">
                    <PathIcon Data="{StaticResource Icon.Redo}" />
                </Button>

                <Border Classes="RoundBorder" Margin="4 0 0 0" Padding="1">
                    <StackPanel Classes="toolbar">
                        <controls:UiExtensionCollection Extensions="{Binding RoundToolBarExtension}" />
                        <StackPanel Classes="toolbar"
                                    IsVisible="{Binding ApplicationStateService.ActiveProcess.Terminate, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Separator />
                            <Button Classes="icon" ToolTip.Tip="Stop"
                                    Command="{Binding ApplicationStateService.TerminateActiveDialogAsync}">
                                <PathIcon Classes="error" Data="{StaticResource Icon.Stop}" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <controls:UiExtensionCollection Extensions="{Binding LeftToolBarExtension}" />

            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Name="RightButtons" Classes="toolbar" VerticalAlignment="Center">
                <controls:UiExtensionCollection Extensions="{Binding RightToolBarExtension}">
                    <controls:UiExtensionCollection.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Classes="toolbar" />
                        </ItemsPanelTemplate>
                    </controls:UiExtensionCollection.ItemsPanel>
                </controls:UiExtensionCollection>
                <Button Classes="icon" ToolTip.Tip="Search Everywhere" Command="{Binding OpenCommandManager}">
                    <PathIcon Data="{StaticResource Icon.Search}" />
                </Button>
                <Button Classes="icon" ToolTip.Tip="Notifications" Command="{Binding MarkNotificationsReadCommand}">
                    <Panel>
                        <PathIcon Data="{StaticResource Icon.Notifications}" />
                        <Ellipse Height="6" Width="6" Fill="{DynamicResource ErrorBrush}" VerticalAlignment="Top"
                                 HorizontalAlignment="Right" Margin="1"
                                 IsVisible="{Binding NewNotificationsAvailable}" />
                    </Panel>

                    <Button.Flyout>
                        <Flyout FlyoutPresenterClasses="flush"
                                Placement="BottomEdgeAlignedRight">
                            <Border Width="340" MaxHeight="280">
                                <Grid RowDefinitions="30,*">
                                    <Panel>
                                        <TextBlock Classes="semibold" Text="Notifications" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Panel>

                                    <Border Background="{DynamicResource ThemeControlLowBrush}" Grid.Row="1"
                                            BorderThickness="0 1 0 0" Padding="5">
                                        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                            <Panel>
                                                <ItemsControl
                                                    ItemsSource="{Binding ApplicationStateService.CurrentNotifications}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Vertical" Spacing="5" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Height="NaN" Command="{Binding Command}"
                                                                    HorizontalContentAlignment="Stretch"
                                                                    VerticalContentAlignment="Stretch">
                                                                <Button.Styles>
                                                                    <Style Selector="Button:disabled">
                                                                        <Setter Property="Opacity" Value="1" />
                                                                    </Style>
                                                                </Button.Styles>
                                                                <Border>
                                                                    <Grid ColumnDefinitions="Auto,*,Auto"
                                                                          ColumnSpacing="10">

                                                                        <!-- Severity indicator -->
                                                                        <Border Width="3"
                                                                                Background="{DynamicResource HighlightBrush}"
                                                                                CornerRadius="{DynamicResource ThemeCornerRadiusSmall}"
                                                                                Classes.Warning="{Binding Kind, Converter={x:Static converters:SharedConverters.ComparisonConverter}, ConverterParameter={x:Static enums:ApplicationNotificationKind.Warning}}"
                                                                                Classes.Error="{Binding Kind, Converter={x:Static converters:SharedConverters.ComparisonConverter}, ConverterParameter={x:Static enums:ApplicationNotificationKind.Error}}">
                                                                            <Border.Styles>
                                                                                <Style Selector="Border.Warning">
                                                                                    <Setter Property="Background"
                                                                                        Value="{DynamicResource WarningBrush}" />
                                                                                </Style>
                                                                                <Style Selector="Border.Error">
                                                                                    <Setter Property="Background"
                                                                                        Value="{DynamicResource ErrorBrush}" />
                                                                                </Style>
                                                                            </Border.Styles>
                                                                        </Border>

                                                                        <TextBlock Grid.Column="1"
                                                                                Text="{Binding Message}"
                                                                                TextWrapping="Wrap" />

                                                                        <!-- Timestamp -->
                                                                        <TextBlock Grid.Column="2"
                                                                                Text="{Binding Timestamp, StringFormat={}{0:HH:mm}}"
                                                                                FontSize="{DynamicResource FontSizeSmall}"
                                                                                Foreground="{DynamicResource ThemeForegroundLowBrush}" />
                                                                    </Grid>
                                                                </Border>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                
                                                <TextBlock Foreground="{DynamicResource ThemeForegroundLowBrush}" Text="No notifications at the moment. Check back later" TextWrapping="Wrap" IsVisible="{Binding !ApplicationStateService.CurrentNotifications.Count}" />
                                            </Panel>

                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Border>
                        </Flyout>
                    </Button.Flyout>

                </Button>
                <Button Classes="icon" ToolTip.Tip="Settings">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="Find..." Command="{Binding OpenCommandManager}">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource Icon.Search}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Settings" Command="{Binding OpenSettingsDialogAsync}">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource Icon.Settings}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Extensions" Command="{Binding OpenPackageManagerAsync}">
                                <MenuItem.Icon>
                                    <PathIcon Data="{StaticResource Icon.Package}" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuFlyout>
                    </Button.Flyout>

                    <PathIcon Data="{StaticResource Icon.Settings}" />
                </Button>
            </StackPanel>
        </DockPanel>

        <DockControl Name="DockControl" Grid.Row="1" Margin="4 0 4 4" Layout="{Binding MainDockService.Layout}" />
    </Grid>
</UserControl>