<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:settingTypes="clr-namespace:OneWare.Settings.ViewModels.SettingTypes"
             xmlns:controls="clr-namespace:OneWare.Essentials.Controls;assembly=OneWare.Essentials"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="OneWare.Settings.Views.SettingTypes.PathSettingView"
             x:DataType="settingTypes:PathSettingViewModel">
    <StackPanel Orientation="Vertical" Spacing="2">
        <StackPanel.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Restore Default" Command="{Binding RestoreDefaultCommand}" />
            </ContextMenu>
        </StackPanel.ContextMenu>
        <StackPanel Spacing="3" Orientation="Horizontal">
            <TextBlock Text="{Binding Setting.Title}"
                       ToolTip.Tip="{Binding Setting.HoverDescription}" />
            <Button Classes="icon" VerticalAlignment="Center"
                    IsVisible="{Binding Setting.MarkdownDocumentation, Converter={x:Static ObjectConverters.IsNotNull}}">
                <PathIcon Classes="muted" Data="{StaticResource Icon.Help}" />
                <Button.Flyout>
                    <Flyout FlyoutPresenterTheme="{StaticResource FlyoutNoPadding}">
                        <controls:MarkdownViewer Markdown="{Binding Setting.MarkdownDocumentation}"
                                                 MaxWidth="900" MaxHeight="500" />
                    </Flyout>
                </Button.Flyout>
            </Button>
        </StackPanel>
        <TextBox IsEnabled="{Binding Setting.IsEnabledObservable^, FallbackValue={x:True}}"
                 Watermark="{Binding Watermark}"
                 Text="{Binding Setting.Value, Mode=TwoWay}">
            <TextBox.InnerRightContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                    <Panel IsVisible="{Binding PathSetting.CanVerify}" Margin="0 0 2 0">
                        <PathIcon Classes="small error" Data="{StaticResource Icon.Close}"
                                  ToolTip.Tip="Path is invalid!" IsVisible="{Binding !PathSetting.IsValid}" />
                        <PathIcon Classes="small success" Data="{StaticResource Icon.Check}"
                                  ToolTip.Tip="Path is valid!" IsVisible="{Binding PathSetting.IsValid}" />
                    </Panel>
                    <Button Classes="icon small" ToolTip.Tip="Browse..."
                            IsEnabled="{Binding Setting.IsEnabledObservable^, FallbackValue={x:True}}"
                            Command="{Binding SelectPathAsync}"
                            CommandParameter="{Binding $self}">
                        <PathIcon Classes="small" Data="{StaticResource Icon.Folder}" />
                    </Button>
                </StackPanel>
            </TextBox.InnerRightContent>
        </TextBox>
        <TextBlock Classes="setting-validation warning caption" />
    </StackPanel>
</UserControl>