<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:services="clr-namespace:OneWare.Copilot.Services"
             xmlns:controls="clr-namespace:OneWare.Essentials.Controls;assembly=OneWare.Essentials"
             mc:Ignorable="d" d:DesignWidth="30" d:DesignHeight="30"
             x:Class="OneWare.Copilot.Views.CopilotChatHeaderView" x:DataType="services:CopilotChatServiceBase">
    <Button Name="OverflowButton" VerticalAlignment="Center" ToolTip.Tip="More">
        <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedRight" Opened="OnFlyoutOpened">
                <StackPanel MinWidth="200" MaxWidth="380" Spacing="8">

                    <StackPanel Spacing="8" IsVisible="{Binding UsesGitHubAuthentication}">
                        <!-- Account state -->
                        <StackPanel Spacing="1" IsVisible="{Binding IsAuthenticated}">
                            <TextBlock Text="Signed in to GitHub Copilot" FontWeight="SemiBold" FontSize="11" />
                            <TextBlock Text="{Binding AccountStatusText, FallbackValue={x:Null}}" FontSize="11"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource ThemeForegroundLowBrush}" />
                        </StackPanel>

                        <TextBlock Text="Not signed in to GitHub Copilot" FontWeight="SemiBold" FontSize="11"
                                   IsVisible="{Binding !IsAuthenticated}" />

                        <TextBlock
                            Text="This login is provided outside of OneWare and cannot be removed here."
                            FontSize="11" TextWrapping="Wrap"
                            Foreground="{DynamicResource ThemeForegroundLowBrush}"
                            IsVisible="{Binding !CanSignOut}" />

                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                IsVisible="{Binding !IsAuthenticated}"
                                Command="{Binding SignInCommand}"
                                CommandParameter="{Binding $self}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Image Source="{DynamicResource Bootstrap.Github}" Width="12" Height="12" />
                                <TextBlock Text="Sign in with GitHub" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                IsVisible="{Binding CanSignOut}"
                                Command="{Binding SignOutCommand}"
                                CommandParameter="{Binding $self}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Image Source="{DynamicResource BoxIcons.RegularLogOutCircle}" Width="12" Height="12" />
                                <TextBlock Text="Sign out" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Spacing="1" IsVisible="{Binding IsByok}">
                        <TextBlock Text="Custom model provider" FontWeight="SemiBold" FontSize="11" />
                        <TextBlock Text="{Binding AccountStatusText, FallbackValue={x:Null}}" FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource ThemeForegroundLowBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="8" IsVisible="{Binding IsOneWareCloud}">
                        <TextBlock Text="{Binding AccountStatusText}" FontWeight="SemiBold" FontSize="11"
                                   IsVisible="{Binding IsAuthenticated}" />
                        <TextBlock Text="Not signed in to OneWare Cloud" FontWeight="SemiBold" FontSize="11"
                                   IsVisible="{Binding !IsAuthenticated}" />
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                IsVisible="{Binding !IsAuthenticated}"
                                Command="{Binding SignInCommand}"
                                CommandParameter="{Binding $self}">
                            <TextBlock Text="Sign in to OneWare Cloud" FontSize="11" />
                        </Button>
                    </StackPanel>

                    <!-- MCP servers of this chat -->
                    <Separator />
                    <StackPanel Spacing="8">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Classes="icon small" ToolTip.Tip="Refresh"
                                    IsVisible="{Binding HasMcpServers}"
                                    Command="{Binding RefreshMcpServersCommand}">
                                <PathIcon Classes="small" Data="{StaticResource Icon.Refresh}" />
                            </Button>
                            <TextBlock Classes="overline" Text="MCP SERVERS" VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding !HasMcpServers}"
                                   Text="No MCP servers in this chat." />

                        <ItemsControl ItemsSource="{Binding McpServers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="services:CopilotMcpServerViewModel">
                                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Classes="semibold" Text="{Binding DisplayName}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <controls:Spinner Width="10" Height="10" IsVisible="{Binding IsBusy}" />
                                            </StackPanel>
                                            <TextBlock Classes="caption" Text="{Binding StatusText}"
                                                       Classes.success="{Binding IsConnected}"
                                                       Classes.warning="{Binding NeedsSignIn}"
                                                       Classes.error="{Binding IsFailed}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                                    VerticalAlignment="Center" Margin="8 0 0 0">
                                            <Button Classes="primary small" Content="Sign In"
                                                    IsVisible="{Binding NeedsSignIn}"
                                                    Command="{Binding SignInCommand}" />
                                            <ToggleSwitch Classes="small" IsChecked="{Binding EnabledInChat}"
                                                          ToolTip.Tip="Use this server in this chat" />
                                        </StackPanel>
                                        <SelectableTextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                             Classes="caption" TextWrapping="Wrap" MaxLines="4"
                                                             Classes.error="{Binding IsFailed}"
                                                             IsVisible="{Binding HasMessage}"
                                                             Text="{Binding Message}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Classes="link" Content="Manage MCP Servers…" HorizontalAlignment="Left"
                                Command="{Binding ManageMcpServersCommand}"
                                CommandParameter="{Binding #OverflowButton}" />
                    </StackPanel>
                </StackPanel>
            </Flyout>
        </Button.Flyout>
        <Panel>
            <Image Source="{DynamicResource BoxIcons.RegularDotsVerticalRounded}" Width="12" Height="12" />
            <Ellipse Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 -2 -3 0"
                     Fill="{DynamicResource WarningBrush}" IsVisible="{Binding HasMcpProblems}"
                     ToolTip.Tip="{Binding McpSummary}" />
        </Panel>
    </Button>
</UserControl>
