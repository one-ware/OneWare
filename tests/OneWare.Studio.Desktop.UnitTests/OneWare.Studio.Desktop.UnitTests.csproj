<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\build\props\XUnit.props"/>

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <IsPackable>False</IsPackable>
        <IsTestProject>True</IsTestProject>
        <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
        <GenerateRuntimeConfigurationFiles>True</GenerateRuntimeConfigurationFiles>
        <Nullable>enable</Nullable>
        <!-- xUnit v3 test projects are executables; Studio.Desktop is self-contained but only referenced as a library here -->
        <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\studio\OneWare.Studio.Desktop\OneWare.Studio.Desktop.csproj"/>
    </ItemGroup>

</Project>
